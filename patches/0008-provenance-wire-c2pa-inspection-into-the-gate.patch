@@ -19,12 +20,16 @@ void ProvenanceGateThrottle::WillProcessResponse(
     const GURL& response_url,
     network::mojom::URLResponseHead* response_head,
     bool* defer) {
-  // Series 0002: the gate wiring. Detector adapters (Series 0007) supply
-  // Evidence; until they exist the engine sees no evidence: Mode A allows
-  // everything, Mode B (provenance_required) fails closed.
-  std::vector<provenance_gate::Evidence> evidence;
+  // Series 0002 wiring: evaluate the policy. Series 0008: detector results
+  // are recorded per-origin by the page-image scanner (C2PA manifest
+  // inspection of the page's <img> bytes); navigations to an origin with
+  // recorded evidence are evaluated against it. Mode A blocks on the
+  // recorded evidence (overridable); Mode B still fails closed regardless.
+  std::vector<provenance_gate::Evidence> evidence =
+      ProvenanceEvidenceStore::Get().GetEvidenceForOrigin(response_url);
   const auto decision = provenance_gate::Evaluate(policy_, evidence);
   VLOG(1) << "provenance_gate: url=" << response_url.spec()
+          << " evidence=" << evidence.size()
           << " allow=" << decision.allow
           << " reason=" << decision.reason;
 
@@ -34,7 +39,7 @@ void ProvenanceGateThrottle::WillProcessResponse(
   if (!decision.allow) {
     *defer = true;
     delegate_->CancelWithError(net::ERR_BLOCKED_BY_CLIENT,
-                                decision.reason);
+                               decision.reason);
   }
 }
 
diff --git a/content/shell/browser/provenance_page_inspector.cc b/content/shell/browser/provenance_page_inspector.cc
new file mode 100644
index 0000000000..946daafdf1
--- /dev/null
+++ b/content/shell/browser/provenance_page_inspector.cc
@@ -0,0 +1,136 @@
+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+#include "content/shell/browser/provenance_page_inspector.h"
+
+#include <optional>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/logging.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/storage_partition.h"
+#include "mojo/public/cpp/base/big_buffer.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace content {
+
+namespace {
+// Resource sanity guards (not policy): how many <img> elements to inspect
+// per page and how many bytes to fetch per image.
+constexpr size_t kMaxImagesPerScan = 10;
+constexpr int kMaxImageBytes = 5 * 1024 * 1024;
+}  // namespace
+
+ProvenanceEvidenceStore& ProvenanceEvidenceStore::Get() {
+  static base::NoDestructor<ProvenanceEvidenceStore> instance;
+  return *instance;
+}
+
+void ProvenanceEvidenceStore::RecordEvidence(
+    const GURL& page_origin,
+    provenance_gate::Evidence evidence) {
+  const std::string key = url::Origin::Create(page_origin).Serialize();
+  base::AutoLock lock(lock_);
+  evidence_by_origin_[key].push_back(std::move(evidence));
+}
+
+std::vector<provenance_gate::Evidence>
+ProvenanceEvidenceStore::GetEvidenceForOrigin(const GURL& url) {
+  const std::string key = url::Origin::Create(url).Serialize();
+  base::AutoLock lock(lock_);
+  auto it = evidence_by_origin_.find(key);
+  if (it == evidence_by_origin_.end()) {
+    return {};
+  }
+  return it->second;
+}
+
+ProvenancePageImageScanner::ProvenancePageImageScanner(
+    BrowserContext* browser_context)
+    : browser_context_(browser_context),
+      decoder_(std::make_unique<data_decoder::DataDecoder>()) {}
+
+ProvenancePageImageScanner::~ProvenancePageImageScanner() = default;
+
+void ProvenancePageImageScanner::Scan(
+    const GURL& page_url,
+    const std::vector<std::string>& image_urls) {
+  if (!inspection_remote_.is_bound()) {
+    decoder_->GetService()->BindProvenanceInspection(
+        inspection_remote_.BindNewPipeAndPassReceiver());
+  }
+  const GURL page_origin = page_url.GetWithEmptyPath();
+  size_t fetched = 0;
+  for (const std::string& image_url_string : image_urls) {
+    if (fetched >= kMaxImagesPerScan) {
+      break;
+    }
+    const GURL image_url(image_url_string);
+    if (!image_url.is_valid() || !image_url.SchemeIsHTTPOrHTTPS()) {
+      continue;
+    }
+    ++fetched;
+    auto resource_request = std::make_unique<network::ResourceRequest>();
+    resource_request->url = image_url;
+    resource_request->method = "GET";
+    auto loader = network::SimpleURLLoader::Create(
+        std::move(resource_request),
+        net::DefineNetworkTrafficAnnotation(
+            "provenance_inspection",
+            "Fetches images for C2PA manifest inspection in the provenance gate."));
+    auto* loader_ptr = loader.get();
+    pending_loaders_.push_back(std::move(loader));
+    loader_ptr->DownloadToString(
+        browser_context_->GetDefaultStoragePartition()
+            ->GetURLLoaderFactoryForBrowserProcess()
+            .get(),
+        base::BindOnce(&ProvenancePageImageScanner::OnImageFetched,
+                       base::Unretained(this), page_origin, image_url),
+        kMaxImageBytes);
+    VLOG(1) << "provenance_gate: image_scan fetching url=" << image_url.spec();
+  }
+}
+
+void ProvenancePageImageScanner::OnImageFetched(
+    const GURL& page_origin,
+    const GURL& image_url,
+    std::optional<std::string> body) {
+  if (!body || body->empty()) {
+    VLOG(1) << "provenance_gate: image_scan fetch failed or empty url="
+            << image_url.spec();
+    return;
+  }
+  VLOG(1) << "provenance_gate: image_scan fetched url=" << image_url.spec()
+          << " bytes=" << body->size();
+  inspection_remote_->InspectImage(
+      mojo_base::BigBuffer(base::as_byte_span(*body)),
+      base::BindOnce(&ProvenancePageImageScanner::OnImageInspected,
+                     base::Unretained(this), page_origin, image_url));
+}
+
+void ProvenancePageImageScanner::OnImageInspected(
+    const GURL& page_origin,
+    const GURL& image_url,
+    data_decoder::mojom::ProvenanceImageInspectionPtr result) {
+  VLOG(1) << "provenance_gate: image_scan result url=" << image_url.spec()
+          << " has_manifest=" << result->has_manifest
+          << " ai_claimed=" << result->ai_claimed
+          << " actions=" << result->claimed_actions.size();
+  if (!result->has_manifest || !result->ai_claimed) {
+    return;
+  }
+  provenance_gate::Evidence evidence;
+  evidence.signal = provenance_gate::Signal::kC2paUnverifiedAiAction;
+  evidence.confidence = 1.0;
+  evidence.source = "c2pa";
+  ProvenanceEvidenceStore::Get().RecordEvidence(page_origin,
+                                                std::move(evidence));
+  VLOG(1) << "provenance_gate: evidence recorded origin="
+          << url::Origin::Create(page_origin).Serialize()
+          << " signal=c2pa_unverified_ai_action";
+}
+
+}  // namespace content
diff --git a/content/shell/browser/provenance_page_inspector.h b/content/shell/browser/provenance_page_inspector.h
new file mode 100644
index 0000000000..8161da9b47
--- /dev/null
+++ b/content/shell/browser/provenance_page_inspector.h
@@ -0,0 +1,81 @@
+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+#ifndef CONTENT_SHELL_BROWSER_PROVENANCE_PAGE_INSPECTOR_H_
+#define CONTENT_SHELL_BROWSER_PROVENANCE_PAGE_INSPECTOR_H_
+
+#include <map>
+#include <optional>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "components/provenance_gate/policy.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/data_decoder/public/cpp/data_decoder.h"
+#include "services/data_decoder/public/mojom/provenance_inspection.mojom.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "content/public/browser/storage_partition.h"
+#include "url/gurl.h"
+
+namespace content {
+class BrowserContext;
+
+// Series 0008: browser-side store of detector Evidence, keyed by page
+// origin. Written by the page-image scanner (UI thread) as C2PA manifest
+// inspections complete; read by the provenance gate throttle (which runs
+// on a different sequence), hence the lock. In-memory only: evidence lives
+// for the browser process lifetime.
+class ProvenanceEvidenceStore {
+ public:
+  static ProvenanceEvidenceStore& Get();
+
+  void RecordEvidence(const GURL& page_origin,
+                      provenance_gate::Evidence evidence);
+  std::vector<provenance_gate::Evidence> GetEvidenceForOrigin(const GURL& url);
+
+ private:
+  friend class base::NoDestructor<ProvenanceEvidenceStore>;
+  ProvenanceEvidenceStore() = default;
+
+  base::Lock lock_;
+  std::map<std::string, std::vector<provenance_gate::Evidence>>
+      evidence_by_origin_;
+};
+
+// Series 0008: fetches a page's <img> URLs, runs each through the sandboxed
+// data_decoder C2PA manifest inspection (Series 0007), and records Evidence
+// for the page origin when the manifest claims AI generation
+// (kC2paUnverifiedAiAction). The manifest signature is NOT validated at this
+// stage — the signal is "a manifest claims X", not "X is trusted".
+class ProvenancePageImageScanner {
+ public:
+  explicit ProvenancePageImageScanner(BrowserContext* browser_context);
+  ~ProvenancePageImageScanner();
+
+  ProvenancePageImageScanner(const ProvenancePageImageScanner&) = delete;
+  ProvenancePageImageScanner& operator=(const ProvenancePageImageScanner&) =
+      delete;
+
+  void Scan(const GURL& page_url, const std::vector<std::string>& image_urls);
+
+ private:
+  void OnImageFetched(const GURL& page_origin,
+                      const GURL& image_url,
+                      std::optional<std::string> body);
+  void OnImageInspected(const GURL& page_origin,
+                        const GURL& image_url,
+                        data_decoder::mojom::ProvenanceImageInspectionPtr
+                            result);
+
+  raw_ptr<BrowserContext> browser_context_;
+  std::unique_ptr<data_decoder::DataDecoder> decoder_;
+  mojo::Remote<data_decoder::mojom::ProvenanceInspection> inspection_remote_;
+  std::vector<std::unique_ptr<network::SimpleURLLoader>> pending_loaders_;
+};
+
+}  // namespace content
+
+#endif  // CONTENT_SHELL_BROWSER_PROVENANCE_PAGE_INSPECTOR_H_
