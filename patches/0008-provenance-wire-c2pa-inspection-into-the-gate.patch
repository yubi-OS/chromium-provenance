diff --git a/components/provenance_gate/public/mojom/provenance_gate.mojom b/components/provenance_gate/public/mojom/provenance_gate.mojom
index 628206255b..77af7e2953 100644
--- a/components/provenance_gate/public/mojom/provenance_gate.mojom
+++ b/components/provenance_gate/public/mojom/provenance_gate.mojom
@@ -5,8 +5,15 @@ module provenance_gate.mojom;
 // Series 0004: the renderer reports extracted main-content text to the
 // browser process. Detector adapters (Series 0007) evaluate the text and
 // feed Evidence to the policy engine.
+// Series 0008: also reports <img> source URLs so the browser can run the
+// sandboxed C2PA manifest inspection over the image bytes and record
+// per-origin Evidence.
 interface ProvenancePageText {
   // |frame_url| is the reported frame URL, |text| its extracted
   // main-content text (renderer-capped at a message-size guard).
   ReportPageText(string frame_url, string text);
+
+  // Series 0008: |image_urls| are absolute http(s) URLs of <img> elements
+  // in the frame's DOM (renderer-capped at a count guard).
+  ReportPageImages(string frame_url, array<string> image_urls);
 };
