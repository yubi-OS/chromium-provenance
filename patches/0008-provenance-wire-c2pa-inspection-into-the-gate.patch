diff --git a/services/data_decoder/provenance_manifest_parser.cc b/services/data_decoder/provenance_manifest_parser.cc
index 2edd0a326f..c70cb25d76 100644
--- a/services/data_decoder/provenance_manifest_parser.cc
+++ b/services/data_decoder/provenance_manifest_parser.cc
@@ -200,6 +200,13 @@ ProvenanceManifest InspectProvenance(const uint8_t* data, size_t size) {
 
   m.found = !jsons.empty();
   for (const std::string& j : jsons) {
+    // Series 0008: flag AI-generation claims. One substring check covers
+    // both the action form (c2pa.actions/trainedAlgorithmicMedia) and the
+    // digital_source_type form
+    // (http://c2pa.org/digitalsourcetype/trainedAlgorithmicMedia).
+    if (j.find("trainedAlgorithmicMedia") != std::string::npos) {
+      m.ai_claimed = true;
+    }
     ExtractActions(j, &m.claimed_actions);
   }
   return m;
diff --git a/services/data_decoder/provenance_manifest_parser.h b/services/data_decoder/provenance_manifest_parser.h
index 6ef9087cc1..ddd3f267dd 100644
--- a/services/data_decoder/provenance_manifest_parser.h
+++ b/services/data_decoder/provenance_manifest_parser.h
@@ -21,6 +21,12 @@ namespace data_decoder {
 // CLAIMS only. Callers must not treat it as trusted provenance.
 struct ProvenanceManifest {
   bool found = false;
+  // Series 0008: the manifest text mentions trainedAlgorithmicMedia — the
+  // C2PA digital source type for AI-generated content. Covers both the
+  // action form (c2pa.actions/trainedAlgorithmicMedia) and the
+  // digital_source_type form
+  // (http://c2pa.org/digitalsourcetype/trainedAlgorithmicMedia).
+  bool ai_claimed = false;
   std::vector<std::string> claimed_actions;  // c2pa.actions/... URIs
   std::string detail;                        // parser notes
 };
diff --git a/services/data_decoder/provenance_manifest_parser_unittest.cc b/services/data_decoder/provenance_manifest_parser_unittest.cc
index 5f9321813a..dfa990f99d 100644
--- a/services/data_decoder/provenance_manifest_parser_unittest.cc
+++ b/services/data_decoder/provenance_manifest_parser_unittest.cc
@@ -143,6 +143,24 @@ TEST(ProvenanceManifestParser, TruncatedJpeg_Safe) {
   EXPECT_FALSE(m.found);
 }
 
+TEST(ProvenanceManifestParser, DigitalSourceType_TriggersAiClaimed) {
+  // Series 0008: the digital_source_type form of the AI signal (used by
+  // real-world generators) must set ai_claimed even with no c2pa.actions.
+  std::string json =
+    "{\"ingredients\":[{\"digital_source_type\":\"http://c2pa.org/digitalsourcetype/trainedAlgorithmicMedia\"}]}";
+  auto jpeg = JpegWithApp11(JumbfWithJson(json));
+  ProvenanceManifest m = InspectProvenance(jpeg.data(), jpeg.size());
+  EXPECT_TRUE(m.found);
+  EXPECT_TRUE(m.ai_claimed);
+}
+
+TEST(ProvenanceManifestParser, NoAiMention_NoAiClaimed) {
+  auto jpeg = JpegWithApp11(JumbfWithJson("{\"title\":\"clean\"}"));
+  ProvenanceManifest m = InspectProvenance(jpeg.data(), jpeg.size());
+  EXPECT_TRUE(m.found);
+  EXPECT_FALSE(m.ai_claimed);
+}
+
 TEST(ProvenanceManifestParser, Garbage_Safe) {
   std::vector<uint8_t> junk(4096, 0xAB);
   ProvenanceManifest m = InspectProvenance(junk.data(), junk.size());
