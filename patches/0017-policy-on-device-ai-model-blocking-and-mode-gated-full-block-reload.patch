+void ProvenanceSettingsHandler::HandleSetBlockAiModels(
+    const base::ListValue& args) {
+  bool enabled = false;
+  for (const auto& v : args) {
+    if (v.is_bool()) { enabled = v.GetBool(); break; }
+  }
+  provenance_gate::ProvenancePolicyStore::Get().SetBlockAiModels(enabled);
+  Profile* profile = Profile::FromWebUI(web_ui());
+  profile->GetPrefs()->SetBoolean(prefs::kProvenanceBlockAiModels, enabled);
+  VLOG(1) << "provenance_gate: settings block_ai_models=" << enabled;
+}
+
+void ProvenanceSettingsHandler::HandleSetAiExemptOrigins(
+    const base::ListValue& args) {
+  std::string origins_str;
+  for (const auto& v : args) {
+    if (v.is_string()) { origins_str = v.GetString(); break; }
+  }
+  Profile* profile = Profile::FromWebUI(web_ui());
+  profile->GetPrefs()->SetString(prefs::kProvenanceAiExemptOrigins,
+                                 origins_str);
+  std::vector<std::string> origins;
+  for (const std::string& origin :
+       base::SplitString(origins_str, ",", base::TRIM_WHITESPACE,
+                         base::SPLIT_WANT_NONEMPTY)) {
+    origins.push_back(origin);
+  }
+  provenance_gate::ProvenancePolicyStore::Get().SetAiExemptions(origins);
+  VLOG(1) << "provenance_gate: settings ai_exempt_origins=" << origins_str;
+}
+
 }  // namespace provenance
