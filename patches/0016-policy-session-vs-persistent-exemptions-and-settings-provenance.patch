@@ -0,0 +1,83 @@
+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+#include "chrome/browser/provenance/provenance_settings_handler.h"
+
+#include <string>
+
+#include "base/logging.h"
+#include "base/strings/string_split.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/pref_names.h"
+#include "components/provenance_gate/browser/provenance_bypass_store.h"
+#include "components/provenance_gate/browser/provenance_policy_store.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_ui.h"
+
+namespace provenance {
+
+void ProvenanceSettingsHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getProvenanceState",
+      base::BindRepeating(&ProvenanceSettingsHandler::HandleGetState,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "setProvenanceMode",
+      base::BindRepeating(&ProvenanceSettingsHandler::HandleSetMode,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "setExemptOrigins",
+      base::BindRepeating(&ProvenanceSettingsHandler::HandleSetExemptOrigins,
+                          base::Unretained(this)));
+}
+
+void ProvenanceSettingsHandler::HandleGetState(
+    const base::ListValue& args) {
+  const std::string mode =
+      ModeToString(provenance_gate::ProvenancePolicyStore::Get().mode());
+  const auto exemptions =
+      provenance_gate::ProvenanceBypassStore::Get().exemptions();
+  std::string origins_str;
+  for (const std::string& o : exemptions) {
+    if (!origins_str.empty()) origins_str += ",";
+    origins_str += o;
+  }
+  web_ui()->CallJavascriptFunctionUnsafe("provenanceStateReady",
+                                         base::Value(mode),
+                                         base::Value(origins_str));
+}
+
+void ProvenanceSettingsHandler::HandleSetMode(
+    const base::ListValue& args) {
+  std::string mode_str;
+  for (const auto& v : args) {
+    if (v.is_string()) { mode_str = v.GetString(); break; }
+  }
+  if (mode_str.empty()) return;
+  provenance_gate::Mode mode = provenance_gate::Mode::kBlockOnDetect;
+  provenance_gate::ModeFromString(mode_str, &mode);
+  provenance_gate::ProvenancePolicyStore::Get().SetMode(mode);
+  Profile* profile = Profile::FromWebUI(web_ui());
+  profile->GetPrefs()->SetString(prefs::kProvenanceMode, mode_str);
+  VLOG(1) << "provenance_gate: settings mode=" << mode_str;
+}
+
+void ProvenanceSettingsHandler::HandleSetExemptOrigins(
+    const base::ListValue& args) {
+  std::string origins_str;
+  for (const auto& v : args) {
+    if (v.is_string()) { origins_str = v.GetString(); break; }
+  }
+  if (origins_str.empty()) return;
+  Profile* profile = Profile::FromWebUI(web_ui());
+  profile->GetPrefs()->SetString(prefs::kProvenanceExemptOrigins,
+                                 origins_str);
+  for (const std::string& origin :
+       base::SplitString(origins_str, ",", base::TRIM_WHITESPACE,
+                         base::SPLIT_WANT_NONEMPTY)) {
+    provenance_gate::ProvenanceBypassStore::Get().AddExemptionSilent(
+        origin, /*persistent=*/true);
+  }
+  VLOG(1) << "provenance_gate: settings exempt_origins=" << origins_str;
+}
+
+}  // namespace provenance
