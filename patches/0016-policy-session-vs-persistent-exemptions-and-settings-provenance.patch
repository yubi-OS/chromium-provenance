+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+import {getTemplate} from './provenance_page.html.js';
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/cr_radio_button/cr_radio_button.js';
+import 'chrome://resources/cr_elements/cr_radio_group/cr_radio_group.js';
+
+interface ChromeSend {
+  send(name: string, args?: unknown[]): void;
+}
+
+function chromeSend(): ChromeSend {
+  return (window as unknown as {chrome: ChromeSend}).chrome;
+}
+
+const MODES: string[] = ['off', 'soft_block_images', 'block_on_detect'];
+
+export class SettingsProvenancePageElement extends PolymerElement {
+  static get is() {
+    return 'settings-provenance-page';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      mode_: {type: String, value: 'block_on_detect'},
+      exemptOrigins_: {type: Array, value: () => []},
+      newOrigin_: {type: String, value: ''},
+    };
+  }
+
+  declare private mode_: string;
+  declare private exemptOrigins_: string[];
+  declare private newOrigin_: string;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    (window as unknown as {provenanceStateReady: unknown}).provenanceStateReady =
+        (mode: string, exemptOrigins: string) => {
+          this.mode_ = mode;
+          this.exemptOrigins_ =
+              exemptOrigins ? exemptOrigins.split(',').filter(
+                  (o: string) => o.length > 0) : [];
+        };
+    this.refresh_();
+  }
+
+  private refresh_() {
+    chromeSend().send('getProvenanceState');
+  }
+
+  private onModeChange_(e: Event) {
+    const mode = (e.target as unknown as {selected: string}).selected;
+    if (MODES.indexOf(mode) === -1) {
+      return;
+    }
+    chromeSend().send('setProvenanceMode', [mode]);
+  }
+
+  private onAdd_() {
+    const origin = (this.newOrigin_ || '').trim().replace(/\/$/, '');
+    if (!origin) {
+      return;
+    }
+    const current = this.exemptOrigins_ || [];
+    if (current.indexOf(origin) === -1) {
+      current.push(origin);
+    }
+    chromeSend().send('setExemptOrigins', [current.join(',')]);
+    this.newOrigin_ = '';
+  }
+
+  private onRemoveClick_(e: Event) {
+    const origin = (e.currentTarget as HTMLElement).dataset['origin'] || '';
+    if (!origin) {
+      return;
+    }
+    const kept = (this.exemptOrigins_ || []).filter((o: string) => o !== origin);
+    chromeSend().send('setExemptOrigins', [kept.join(',')]);
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-provenance-page': SettingsProvenancePageElement,
+  }
+}
+
+customElements.define(
+    SettingsProvenancePageElement.is, SettingsProvenancePageElement);
