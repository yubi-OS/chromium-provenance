+namespace provenance {
+
+class ProvenancePrefsService;
+
+// Series 0013: per-profile sync between provenance prefs and the gate's
+// in-process stores. Created on the first location-bar refresh (the chip's
+// RefreshEvidence) so the stores reflect prefs before any gate decision.
+class ProvenancePrefsServiceFactory : public ProfileKeyedServiceFactory {
+ public:
+  static ProvenancePrefsService* GetForProfile(Profile* profile);
+  static ProvenancePrefsServiceFactory* GetInstance();
+
+ private:
+  friend class base::NoDestructor<ProvenancePrefsServiceFactory>;
+  ProvenancePrefsServiceFactory();
+  ~ProvenancePrefsServiceFactory() override = default;
+
+  // BrowserContextKeyedServiceFactory:
+  std::unique_ptr<KeyedService> BuildServiceInstanceForBrowserContext(
+      content::BrowserContext* context) const override;
+};
+
+}  // namespace provenance
+
+#endif  // CHROME_BROWSER_PROVENANCE_PROVENANCE_PREFS_SERVICE_FACTORY_H_
