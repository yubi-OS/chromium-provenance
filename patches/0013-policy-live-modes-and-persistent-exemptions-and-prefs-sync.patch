diff --git a/chrome/browser/provenance/provenance_prefs_service.cc b/chrome/browser/provenance/provenance_prefs_service.cc
new file mode 100644
index 0000000000..0182c2a1c2
--- /dev/null
+++ b/chrome/browser/provenance/provenance_prefs_service.cc
@@ -0,0 +1,82 @@
+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+#include "chrome/browser/provenance/provenance_prefs_service.h"
+
+#include <string>
+
+#include "base/callback_list.h"
+#include "base/logging.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/provenance_gate/browser/provenance_bypass_store.h"
+#include "components/provenance_gate/browser/provenance_policy_store.h"
+
+namespace provenance {
+
+namespace {
+std::string JoinOrigins(const std::vector<std::string>& origins) {
+  std::string joined;
+  for (const std::string& origin : origins) {
+    if (!joined.empty()) {
+      joined += ",";
+    }
+    joined += origin;
+  }
+  return joined;
+}
+}  // namespace
+
+ProvenancePrefsService::ProvenancePrefsService(PrefService* prefs)
+    : prefs_(prefs) {
+  pref_change_registrar_.Init(prefs_);
+  pref_change_registrar_.Add(
+      prefs::kProvenanceMode,
+      base::BindRepeating(&ProvenancePrefsService::SyncFromPrefs,
+                          base::Unretained(this)));
+  pref_change_registrar_.Add(
+      prefs::kProvenanceExemptOrigins,
+      base::BindRepeating(&ProvenancePrefsService::SyncFromPrefs,
+                          base::Unretained(this)));
+  exemption_subscription_ =
+      provenance_gate::ProvenanceBypassStore::Get().AddExemptionChangedCallback(
+          base::BindRepeating(&ProvenancePrefsService::OnExemptionChanged,
+                              base::Unretained(this)));
+  SyncFromPrefs();
+}
+
+ProvenancePrefsService::~ProvenancePrefsService() = default;
+
+void ProvenancePrefsService::SyncFromPrefs() {
+  syncing_from_prefs_ = true;
+  provenance_gate::Mode mode = provenance_gate::Mode::kBlockOnDetect;
+  if (provenance_gate::ModeFromString(
+          prefs_->GetString(prefs::kProvenanceMode), &mode)) {
+    provenance_gate::ProvenancePolicyStore::Get().SetMode(mode);
+    VLOG(1) << "provenance_gate: prefs mode="
+            << provenance_gate::ModeToString(mode);
+  }
+  for (const std::string& origin :
+       base::SplitString(prefs_->GetString(prefs::kProvenanceExemptOrigins),
+                         ",", base::TRIM_WHITESPACE,
+                         base::SPLIT_WANT_NONEMPTY)) {
+    provenance_gate::ProvenanceBypassStore::Get().AddExemptionSilent(origin);
+  }
+  syncing_from_prefs_ = false;
+}
+
+void ProvenancePrefsService::WriteExemptionsToPrefs() {
+  prefs_->SetString(
+      prefs::kProvenanceExemptOrigins,
+      JoinOrigins(provenance_gate::ProvenanceBypassStore::Get().exemptions()));
+}
+
+void ProvenancePrefsService::OnExemptionChanged(const std::string& origin_key) {
+  if (syncing_from_prefs_) {
+    return;
+  }
+  VLOG(1) << "provenance_gate: exemption persisted " << origin_key;
+  WriteExemptionsToPrefs();
+}
+
+}  // namespace provenance
diff --git a/chrome/browser/provenance/provenance_prefs_service.h b/chrome/browser/provenance/provenance_prefs_service.h
