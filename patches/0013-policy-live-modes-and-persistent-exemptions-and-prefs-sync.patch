+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+#include "chrome/browser/provenance/provenance_prefs_service_factory.h"
+
+#include <utility>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/provenance/provenance_prefs_service.h"
+#include "components/keyed_service/core/keyed_service.h"
+
+namespace provenance {
+
+// static
+ProvenancePrefsService* ProvenancePrefsServiceFactory::GetForProfile(
+    Profile* profile) {
+  return static_cast<ProvenancePrefsService*>(
+      GetInstance()->GetServiceForBrowserContext(profile, /*create=*/true));
+}
+
+// static
+ProvenancePrefsServiceFactory* ProvenancePrefsServiceFactory::GetInstance() {
+  static base::NoDestructor<ProvenancePrefsServiceFactory> instance;
+  return instance.get();
+}
+
+ProvenancePrefsServiceFactory::ProvenancePrefsServiceFactory()
+    : ProfileKeyedServiceFactory("ProvenancePrefsService") {}
+
+std::unique_ptr<KeyedService>
+ProvenancePrefsServiceFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  Profile* profile = Profile::FromBrowserContext(context);
+  return std::make_unique<ProvenancePrefsService>(profile->GetPrefs());
+}
+
+}  // namespace provenance
