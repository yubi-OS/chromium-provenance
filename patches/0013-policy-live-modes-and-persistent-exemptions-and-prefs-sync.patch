@@ -0,0 +1,41 @@
+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+#ifndef COMPONENTS_PROVENANCE_GATE_BROWSER_PROVENANCE_POLICY_STORE_H_
+#define COMPONENTS_PROVENANCE_GATE_BROWSER_PROVENANCE_POLICY_STORE_H_
+
+#include <string>
+
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "components/provenance_gate/policy.h"
+
+namespace provenance_gate {
+
+// Series 0013: process-wide live view of the gate mode. Chrome keeps it in
+// sync with the provenance prefs (ProvenancePrefsService); content_shell
+// seeds it from the --provenance-mode switch. The gate throttle reads the
+// live mode so runtime mode changes take effect without a restart.
+class ProvenancePolicyStore {
+ public:
+  static ProvenancePolicyStore& Get();
+
+  // Applies |default_mode| only if the mode was never explicitly set.
+  void InitIfUnset(Mode default_mode);
+  void SetMode(Mode mode);
+  Mode mode();
+
+ private:
+  friend class base::NoDestructor<ProvenancePolicyStore>;
+  ProvenancePolicyStore() = default;
+
+  base::Lock lock_;
+  Mode mode_ = Mode::kBlockOnDetect;
+  bool initialized_ = false;
+};
+
+// Mode <-> settings-string helpers (chrome prefs, --provenance-mode).
+const char* ModeToString(Mode mode);
+bool ModeFromString(const std::string& s, Mode* out);
+
+}  // namespace provenance_gate
+
+#endif  // COMPONENTS_PROVENANCE_GATE_BROWSER_PROVENANCE_POLICY_STORE_H_
