+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+#ifndef CHROME_BROWSER_PROVENANCE_PROVENANCE_PREFS_SERVICE_H_
+#define CHROME_BROWSER_PROVENANCE_PROVENANCE_PREFS_SERVICE_H_
+
+#include <string>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "components/prefs/pref_change_registrar.h"
+
+class PrefService;
+
+namespace provenance {
+
+// Series 0013: keeps the provenance prefs (mode + exempt origins) and the
+// in-process stores (ProvenancePolicyStore, ProvenanceBypassStore) in sync.
+// Prefs are the source of truth; the stores are the live view the gate
+// throttle reads. Store-side exemption changes (interstitial Proceed, the
+// soft-mode Allow) write through to prefs.
+class ProvenancePrefsService : public KeyedService {
+ public:
+  explicit ProvenancePrefsService(PrefService* prefs);
+  ~ProvenancePrefsService() override;
+
+  ProvenancePrefsService(const ProvenancePrefsService&) = delete;
+  ProvenancePrefsService& operator=(const ProvenancePrefsService&) = delete;
+
+ private:
+  void SyncFromPrefs();
+  void WriteExemptionsToPrefs();
+  void OnExemptionChanged(const std::string& origin_key);
+
+  raw_ptr<PrefService> prefs_;
+  PrefChangeRegistrar pref_change_registrar_;
+  base::CallbackListSubscription exemption_subscription_;
+  bool syncing_from_prefs_ = false;
+};
+
+}  // namespace provenance
+
+#endif  // CHROME_BROWSER_PROVENANCE_PROVENANCE_PREFS_SERVICE_H_
