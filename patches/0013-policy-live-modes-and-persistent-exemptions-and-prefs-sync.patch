diff --git a/components/provenance_gate/browser/provenance_policy_store.cc b/components/provenance_gate/browser/provenance_policy_store.cc
new file mode 100644
index 0000000000..fd10706502
--- /dev/null
+++ b/components/provenance_gate/browser/provenance_policy_store.cc
@@ -0,0 +1,64 @@
+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+#include "components/provenance_gate/browser/provenance_policy_store.h"
+
+namespace provenance_gate {
+
+ProvenancePolicyStore& ProvenancePolicyStore::Get() {
+  static base::NoDestructor<ProvenancePolicyStore> instance;
+  return *instance;
+}
+
+void ProvenancePolicyStore::InitIfUnset(Mode default_mode) {
+  base::AutoLock lock(lock_);
+  if (!initialized_) {
+    mode_ = default_mode;
+    initialized_ = true;
+  }
+}
+
+void ProvenancePolicyStore::SetMode(Mode mode) {
+  base::AutoLock lock(lock_);
+  mode_ = mode;
+  initialized_ = true;
+}
+
+Mode ProvenancePolicyStore::mode() {
+  base::AutoLock lock(lock_);
+  return mode_;
+}
+
+const char* ModeToString(Mode mode) {
+  switch (mode) {
+    case Mode::kBlockOnDetect:
+      return "block_on_detect";
+    case Mode::kProvenanceRequired:
+      return "provenance_required";
+    case Mode::kOff:
+      return "off";
+    case Mode::kSoftBlockImages:
+      return "soft_block_images";
+  }
+  return "block_on_detect";
+}
+
+bool ModeFromString(const std::string& s, Mode* out) {
+  if (s == "block_on_detect") {
+    *out = Mode::kBlockOnDetect;
+    return true;
+  }
+  if (s == "provenance_required") {
+    *out = Mode::kProvenanceRequired;
+    return true;
+  }
+  if (s == "off") {
+    *out = Mode::kOff;
+    return true;
+  }
+  if (s == "soft_block_images") {
+    *out = Mode::kSoftBlockImages;
+    return true;
+  }
+  return false;
+}
+
+}  // namespace provenance_gate
