 #include "url/gurl.h"
 
 namespace provenance_gate {
 
+namespace {
+// Series 0014: the soft-mode notice flow. Blocked image responses carry the
+// same block reason as full-block mode; the renderer replaces them with
+// notices (ProvenancePageTextObserver) whose Allow button re-points the
+// <img> at the bypass marker, which lands here and exempts the origin.
+constexpr char kSoftBlockReason[] = "c2pa_unverified_ai_action";
+
+bool IsImageMime(const network::mojom::URLResponseHead* response_head) {
+  if (!response_head) {
+    return false;
+  }
+  const std::string& mime = response_head->mime_type;
+  return mime.rfind("image/", 0) == 0;
+}
+}  // namespace
+
 ProvenanceGateThrottle::ProvenanceGateThrottle(const Policy& policy)
     : policy_(policy) {
   // Series 0013: seed the live mode store from the switch-derived policy
@@ -27,37 +44,50 @@ void ProvenanceGateThrottle::WillProcessResponse(
     const GURL& response_url,
     network::mojom::URLResponseHead* response_head,
     bool* defer) {
-  // Series 0008 wiring: detector results are recorded per-origin by the
-  // page-image scanner (C2PA manifest inspection of the page's <img>
-  // bytes); navigations to an origin with recorded evidence are evaluated
-  // against it. Mode A blocks on the recorded evidence (overridable); Mode
-  // B still fails closed regardless.
   // Series 0013: consult the live mode (prefs-driven in chrome, switch in
-  // content_shell). kOff and kSoftBlockImages allow everything at the
-  // network layer; kSoftBlockImages enforcement is renderer-side (0014).
+  // content_shell) so runtime mode changes take effect without a restart.
   const Mode live_mode = ProvenancePolicyStore::Get().mode();
-  if (live_mode != Mode::kBlockOnDetect &&
-      live_mode != Mode::kProvenanceRequired) {
+
+  // Bypass adoption runs in every blocking mode: a request carrying the
+  // marker records the origin exemption and loads.
+  const bool adopted =
+      ProvenanceBypassStore::Get().MaybeAdoptBypassRequest(response_url);
+  const bool bypassed =
+      adopted || ProvenanceBypassStore::Get().IsBypassed(response_url);
+  if (bypassed) {
+    VLOG(1) << "provenance_gate: url=" << response_url.spec()
+            << " allow=1 reason=user_bypass";
+    return;
+  }
+
+  // Series 0013: kOff allows everything.
+  if (live_mode == Mode::kOff) {
     VLOG(1) << "provenance_gate: url=" << response_url.spec()
-            << " allow=1 reason=mode_no_block";
+            << " allow=1 reason=mode_off";
     return;
   }
 
-  // Series 0012: a bypass-marked navigation records the user's
-  // proceed-anywhere choice for the origin, then loads (block-on-detect
-  // mode only; provenance_required fails closed).
-  if (live_mode == Mode::kBlockOnDetect) {
-    const bool adopted =
-        ProvenanceBypassStore::Get().MaybeAdoptBypassRequest(response_url);
-    const bool bypassed =
-        adopted || ProvenanceBypassStore::Get().IsBypassed(response_url);
-    if (bypassed) {
-      VLOG(1) << "provenance_gate: url=" << response_url.spec()
-              << " allow=1 reason=user_bypass";
+  // Series 0014: kSoftBlockImages — documents render; image responses whose
+  // origin has recorded AI-content evidence are blocked and replaced with
+  // notices renderer-side.
+  if (live_mode == Mode::kSoftBlockImages) {
+    if (!IsImageMime(response_head)) {
+      return;
+    }
+    std::vector<Evidence> evidence =
+        ProvenanceEvidenceStore::Get().GetEvidenceForOrigin(response_url);
+    if (evidence.empty()) {
       return;
     }
+    VLOG(1) << "provenance_gate: url=" << response_url.spec()
+            << " evidence=" << evidence.size()
+            << " block=1 reason=" << kSoftBlockReason;
+    *defer = true;
+    delegate_->CancelWithError(net::ERR_BLOCKED_BY_CLIENT, kSoftBlockReason);
+    return;
   }
 
+  // kBlockOnDetect / kProvenanceRequired: full-block evaluation.
   std::vector<Evidence> evidence =
       ProvenanceEvidenceStore::Get().GetEvidenceForOrigin(response_url);
   const auto decision = Evaluate(policy_, evidence);
@@ -66,9 +96,8 @@ void ProvenanceGateThrottle::WillProcessResponse(
           << " allow=" << decision.allow
           << " reason=" << decision.reason;
 
-  // Series 0003: block action. content_shell shows its network error page
-  // (ERR_BLOCKED_BY_CLIENT); the chrome interstitial with signal/source/
-  // confidence/proceed-anyway lands as a follow-up series.
+  // Series 0003: block action. The chrome interstitial (series 0012) takes
+  // over the error page; content_shell shows its network error page.
   if (!decision.allow) {
     *defer = true;
     delegate_->CancelWithError(net::ERR_BLOCKED_BY_CLIENT, decision.reason);
