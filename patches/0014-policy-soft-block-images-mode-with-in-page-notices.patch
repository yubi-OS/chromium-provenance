 namespace provenance_gate {
@@ -23,6 +25,19 @@ namespace {
 // Message-size guard, not policy: the classifier floor
 // (Policy::classifier_min_chars) is applied browser-side.
 constexpr size_t kMaxReportedChars = 20000;
+
+// Series 0014: escape a URL for embedding in a JS double-quoted string.
+std::string JsQuoteEscape(const std::string& in) {
+  std::string out;
+  out.reserve(in.size() + 8);
+  for (const char c : in) {
+    if (c == '\\' || c == '"') {
+      out += '\\';
+    }
+    out += c;
+  }
+  return out;
+}
 }  // namespace
 
 ProvenancePageTextObserver::ProvenancePageTextObserver(
@@ -124,7 +139,133 @@ void ProvenancePageTextObserver::WalkImages() {
           remote_.BindNewPipeAndPassReceiver());
     }
     remote_->ReportPageImages(url.spec(), image_urls);
+    // Series 0014: soft mode — ask the browser which of these images the
+    // gate blocks, and swap those for notices.
+    remote_->GetBlockedImages(
+        url.spec(), image_urls,
+        base::BindOnce(&ProvenancePageTextObserver::OnBlockedImages,
+                       weak_factory_.GetWeakPtr()));
+  }
+}
+
+void ProvenancePageTextObserver::OnBlockedImages(
+    const std::vector<std::string>& blocked_urls) {
+  if (blocked_urls.empty()) {
+    return;
+  }
+  blink::WebLocalFrame* web_frame = render_frame()->GetWebFrame();
+  if (!web_frame) {
+    return;
   }
+  // Series 0014: swap blocked images for same-size notices. The Allow
+  // button re-points the <img> at the bypass marker; the gate throttle
+  // adopts it into the exemption store and the image reloads.
+  std::string json = "[";
+  bool first = true;
+  for (const std::string& blocked_url : blocked_urls) {
+    if (!first) {
+      json += ",";
+    }
+    first = false;
+    json += "\"" + JsQuoteEscape(blocked_url) + "\"";
+  }
+  json += "]";
+  const std::string js =
+      "(function(){"
+      "var blocked=" + json + ";"
+      "var MARK='__provenance_bypass=1';"
+      "document.querySelectorAll('img').forEach(function(img){"
+      "var src=img.currentSrc||img.src||'';"
+      "if(!src)return;"
+      "var hit=null;"
+      "for(var i=0;i<blocked.length;i++){"
+      "if(src.indexOf(blocked[i])===0){hit=blocked[i];break;}}"
+      "if(!hit||img.dataset.provenanceBlocked)return;"
+      "if(!img.parentNode)return;"
+      "img.dataset.provenanceBlocked='1';"
+      "var w=img.width||320,h=img.height||150;"
+      "var d=document.createElement('div');"
+      "d.style.cssText='width:'+w+'px;height:'+h+'px;box-sizing:border-box;"
+      "display:flex;flex-direction:column;align-items:center;"
+      "justify-content:center;gap:8px;background:#0B1026;color:#e8e8ef;"
+      "border:1px solid #c52219;border-radius:6px;font-family:sans-serif;"
+      "font-size:12px;text-align:center;padding:10px;overflow:hidden;';"
+      "var t=document.createElement('div');"
+      "t.textContent='AI image blocked';"
+      "t.style.cssText='color:#ff6b5e;font-weight:700;';"
+      "var a=document.createElement('a');"
+      "a.textContent='Allow';"
+      "a.href='#';"
+      "a.style.cssText='background:#c52219;color:#fff;padding:4px 16px;"
+      "border-radius:4px;text-decoration:none;font-weight:600;"
+      "cursor:pointer;';"
+      "a.addEventListener('click',function(ev){ev.preventDefault();img.dataset.provenanceAllow='1';"
+      "var o=img.getAttribute('src')||img.src||'';"
+      "if(o.indexOf(MARK)===-1)o+=(o.indexOf('?')===-1?'?':'&')+MARK;+'&t='+Date.now();"
+      "img.onload=function(){img.style.display='';d.remove();};"
+      "img.src=o;});"
+      "d.appendChild(t);d.appendChild(a);"
+      "img.style.display='none';"
+      "img.parentNode.insertBefore(d,img);"
+      "});"
+      "})();";
+  web_frame->ExecuteScript(
+      blink::WebScriptSource(blink::WebString::FromUtf8(js)));
+  VLOG(1) << "provenance_gate: soft notices for " << blocked_urls.size()
+          << " images";
+  // Series 0014 fixup: poll for Allow clicks and relay exemptions over mojo
+  // (renderer subresource loads never consult the network throttle here).
+  allow_polls_left_ = 10;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&ProvenancePageTextObserver::PollAllowRequests,
+                     weak_factory_.GetWeakPtr()),
+      base::Seconds(1));
+}
+
+void ProvenancePageTextObserver::PollAllowRequests() {
+  if (allow_polls_left_ <= 0) {
+    return;
+  }
+  --allow_polls_left_;
+  blink::WebLocalFrame* web_frame = render_frame()->GetWebFrame();
+  if (web_frame) {
+    blink::WebDocument document = web_frame->GetDocument();
+    if (!document.IsNull()) {
+      blink::WebElement body = document.Body();
+      if (!body.IsNull()) {
+        blink::WebElementCollection images =
+            body.GetElementsByHTMLTagName("img");
+        for (blink::WebElement element = images.FirstItem();
+             !element.IsNull(); element = images.NextItem()) {
+          blink::WebString allowed =
+              element.GetAttribute("data-provenance-allow");
+          if (allowed.IsEmpty()) {
+            continue;
+          }
+          element.SetAttribute("data-provenance-allow", "");
+          blink::WebString src_attr = element.GetAttribute("src");
+          const GURL image_url(
+              document.CompleteURL(src_attr).GetString().Utf8());
+          if (!image_url.is_valid()) {
+            continue;
+          }
+          if (!remote_.is_bound()) {
+            render_frame()->GetBrowserInterfaceBroker().GetInterface(
+                remote_.BindNewPipeAndPassReceiver());
+          }
+          remote_->RequestExemption(image_url.GetWithEmptyPath().spec());
+          VLOG(1) << "provenance_gate: allow relayed for "
+                  << image_url.spec();
+        }
+      }
+    }
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&ProvenancePageTextObserver::PollAllowRequests,
+                     weak_factory_.GetWeakPtr()),
+      base::Seconds(1));
 }
 
