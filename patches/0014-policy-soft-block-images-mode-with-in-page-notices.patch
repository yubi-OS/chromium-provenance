 #include "base/no_destructor.h"
+#include "components/provenance_gate/browser/provenance_bypass_store.h"
+#include "components/provenance_gate/browser/provenance_evidence_store.h"
 #include "components/provenance_gate/browser/provenance_page_inspector.h"
+#include "components/provenance_gate/browser/provenance_policy_store.h"
 #include "components/provenance_gate/policy.h"
 #include "components/provenance_gate/public/mojom/provenance_gate.mojom.h"
 #include "mojo/public/cpp/bindings/pending_receiver.h"
@@ -72,6 +76,39 @@ class ProvenancePageTextImpl : public mojom::ProvenancePageText {
     image_scanner_->Scan(GURL(frame_url), image_urls);
   }
 
+  // Series 0014: soft-mode query — report which of |image_urls| the gate
+  // blocks (origin has recorded evidence, no exemption). Empty outside
+  // kSoftBlockImages mode.
+  void GetBlockedImages(
+      const std::string& frame_url,
+      const std::vector<std::string>& image_urls,
+      GetBlockedImagesCallback callback) override {
+    std::vector<std::string> blocked;
+    if (ProvenancePolicyStore::Get().mode() == Mode::kSoftBlockImages) {
+      for (const std::string& image_url_string : image_urls) {
+        const GURL image_url(image_url_string);
+        if (!image_url.is_valid() ||
+            ProvenanceBypassStore::Get().IsBypassed(image_url)) {
+          continue;
+        }
+        if (!ProvenanceEvidenceStore::Get()
+                 .GetEvidenceForOrigin(image_url)
+                 .empty()) {
+          blocked.push_back(image_url_string);
+        }
+      }
+    }
+    std::move(callback).Run(blocked);
+  }
+
+  // Series 0014 fixup: soft-mode Allow relay — the renderer observer polls
+  // for the notice's Allow clicks and relays them here; the exemption store
+  // is browser-side, and the prefs service persists it.
+  void RequestExemption(const std::string& origin_url) override {
+    ProvenanceBypassStore::Get().AddExemption(GURL(origin_url));
+    VLOG(1) << "provenance_gate: exemption requested for " << origin_url;
+  }
+
  private:
   raw_ptr<content::BrowserContext> browser_context_;
   std::unique_ptr<ProvenancePageImageScanner> image_scanner_;
diff --git a/components/provenance_gate/public/mojom/provenance_gate.mojom b/components/provenance_gate/public/mojom/provenance_gate.mojom
index 77af7e2953..49e41abedd 100644
--- a/components/provenance_gate/public/mojom/provenance_gate.mojom
+++ b/components/provenance_gate/public/mojom/provenance_gate.mojom
@@ -16,4 +16,17 @@ interface ProvenancePageText {
   // Series 0008: |image_urls| are absolute http(s) URLs of <img> elements
   // in the frame's DOM (renderer-capped at a count guard).
   ReportPageImages(string frame_url, array<string> image_urls);
+
+  // Series 0014: soft-mode query — the renderer asks which of |image_urls|
+  // the gate blocks (image responses whose origin has recorded evidence
+  // and no exemption). Only answered in kSoftBlockImages mode; every other
+  // mode returns an empty list.
+  GetBlockedImages(string page_url, array<string> image_urls)
+      => (array<string> blocked_urls);
+
+  // Series 0014 fixup: the soft-mode notice's Allow button asks the browser
+  // to exempt |origin_url|. Needed because renderer subresource loads
+  // (including the marker re-point) do not consult the network-layer
+  // throttle in chrome — the exemption must ride the mojo pipe.
+  RequestExemption(string origin_url);
 };
diff --git a/components/provenance_gate/renderer/provenance_page_text_observer.cc b/components/provenance_gate/renderer/provenance_page_text_observer.cc
