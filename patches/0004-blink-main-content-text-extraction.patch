index 0000000000..628206255b
--- /dev/null
+++ b/components/provenance_gate/public/mojom/provenance_gate.mojom
@@ -0,0 +1,12 @@
+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+
+module provenance_gate.mojom;
+
+// Series 0004: the renderer reports extracted main-content text to the
+// browser process. Detector adapters (Series 0007) evaluate the text and
+// feed Evidence to the policy engine.
+interface ProvenancePageText {
+  // |frame_url| is the reported frame URL, |text| its extracted
+  // main-content text (renderer-capped at a message-size guard).
+  ReportPageText(string frame_url, string text);
+};
diff --git a/components/provenance_gate/renderer/provenance_page_text_observer.cc b/components/provenance_gate/renderer/provenance_page_text_observer.cc
new file mode 100644
index 0000000000..dbd15c48c3
--- /dev/null
+++ b/components/provenance_gate/renderer/provenance_page_text_observer.cc
@@ -0,0 +1,68 @@
+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+#include "components/provenance_gate/renderer/provenance_page_text_observer.h"
+
+#include <utility>
+
+#include "base/logging.h"
+#include "content/public/renderer/render_frame.h"
+#include "third_party/blink/public/platform/browser_interface_broker_proxy.h"
+#include "third_party/blink/public/platform/web_string.h"
+#include "third_party/blink/public/web/web_document.h"
+#include "third_party/blink/public/web/web_local_frame.h"
+#include "url/gurl.h"
+
+namespace provenance_gate {
+
+namespace {
+// Message-size guard, not policy: the classifier floor
+// (Policy::classifier_min_chars) is applied browser-side.
+constexpr size_t kMaxReportedChars = 20000;
+}  // namespace
+
+ProvenancePageTextObserver::ProvenancePageTextObserver(
+    content::RenderFrame* render_frame)
+    : content::RenderFrameObserver(render_frame) {}
+
+ProvenancePageTextObserver::~ProvenancePageTextObserver() = default;
+
+void ProvenancePageTextObserver::DidFinishLoad() {
+  if (reported_) {
+    return;
+  }
+  reported_ = true;
+
+  if (!render_frame()->IsMainFrame()) {
+    return;
+  }
+  blink::WebLocalFrame* web_frame = render_frame()->GetWebFrame();
+  if (!web_frame) {
+    return;
+  }
+  blink::WebDocument document = web_frame->GetDocument();
+  if (document.IsNull()) {
+    return;
+  }
+
+  // Visible text (dump-as-text semantics: no script/style text). Capped at
+  // a transport guard; classification floors live in the Policy.
+  std::string text = document.ContentAsTextForTesting().Utf8();
+  if (text.size() > kMaxReportedChars) {
+    text.resize(kMaxReportedChars);
+  }
+
+  const GURL url(document.Url().GetString().Utf8());
+  VLOG(1) << "provenance_gate: renderer page_text url=" << url.spec()
+          << " chars=" << text.size();
+
+  if (!remote_.is_bound()) {
+    render_frame()->GetBrowserInterfaceBroker().GetInterface(
+        remote_.BindNewPipeAndPassReceiver());
+  }
+  remote_->ReportPageText(url.spec(), text);
+}
+
+void ProvenancePageTextObserver::OnDestruct() {
+  delete this;
+}
+
+}  // namespace provenance_gate
diff --git a/components/provenance_gate/renderer/provenance_page_text_observer.h b/components/provenance_gate/renderer/provenance_page_text_observer.h
new file mode 100644
index 0000000000..1503e210a4
--- /dev/null
+++ b/components/provenance_gate/renderer/provenance_page_text_observer.h
@@ -0,0 +1,35 @@
+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+#ifndef COMPONENTS_PROVENANCE_GATE_RENDERER_PROVENANCE_PAGE_TEXT_OBSERVER_H_
+#define COMPONENTS_PROVENANCE_GATE_RENDERER_PROVENANCE_PAGE_TEXT_OBSERVER_H_
+
+#include "components/provenance_gate/public/mojom/provenance_gate.mojom.h"
+#include "content/public/renderer/render_frame_observer.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+namespace provenance_gate {
+
+// Series 0004: extracts the main frame text once the frame finishes
+// loading and hands it to the browser over mojo. Policy floors
+// (classifier_min_chars) are applied browser-side; this side only extracts
+// and transports. The renderer-side cap is a message-size guard, not policy.
+class ProvenancePageTextObserver : public content::RenderFrameObserver {
+ public:
+  explicit ProvenancePageTextObserver(content::RenderFrame* render_frame);
+  ~ProvenancePageTextObserver() override;
+
+  ProvenancePageTextObserver(const ProvenancePageTextObserver&) = delete;
+  ProvenancePageTextObserver& operator=(const ProvenancePageTextObserver&) =
+      delete;
+
+ private:
+  // content::RenderFrameObserver:
+  void DidFinishLoad() override;
+  void OnDestruct() override;
+
+  mojo::Remote<mojom::ProvenancePageText> remote_;
+  bool reported_ = false;
+};
+
+}  // namespace provenance_gate
+
+#endif  // COMPONENTS_PROVENANCE_GATE_RENDERER_PROVENANCE_PAGE_TEXT_OBSERVER_H_
