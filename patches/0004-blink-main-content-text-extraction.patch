   void ShutDown() override { Shell::Shutdown(); }
 };
 
+
+// Series 0004: browser-side store of reported page text. UI-thread only
+// (frame-bound interfaces bind there). Detector adapters (Series 0007)
+// will read this to build Evidence.
+class ProvenancePageTextStore {
+ public:
+  static ProvenancePageTextStore& Get() {
+    static base::NoDestructor<ProvenancePageTextStore> instance;
+    return *instance;
+  }
+
+  void Record(const GURL& url, const std::string& text) {
+    const size_t chars = text.size();
+    const bool above_floor =
+        chars >= provenance_gate::Policy().classifier_min_chars;
+    pages_[url.spec()] = text;
+    VLOG(1) << "provenance_gate: page_text url=" << url.spec()
+            << " chars=" << chars << " above_floor=" << above_floor;
+  }
+
+ private:
+  std::map<std::string, std::string> pages_;
+};
+
+class ProvenancePageTextImpl
+    : public provenance_gate::mojom::ProvenancePageText {
+ public:
+  ProvenancePageTextImpl() = default;
+
+  void ReportPageText(const std::string& frame_url,
+                      const std::string& text) override {
+    ProvenancePageTextStore::Get().Record(GURL(frame_url), text);
+  }
+};
+
+void BindProvenancePageText(
+    content::RenderFrameHost* render_frame_host,
+    mojo::PendingReceiver<provenance_gate::mojom::ProvenancePageText>
+        receiver) {
+  DCHECK(render_frame_host);
+  mojo::MakeSelfOwnedReceiver(
+      std::make_unique<ProvenancePageTextImpl>(), std::move(receiver));
+}
+
 void BindRustTestServiceReceiver(
     RenderFrameHost* render_frame_host,
     mojo::PendingReceiver<content::rust_test::mojom::RustTestService>
@@ -650,6 +698,8 @@ void ShellContentBrowserClient::RegisterBrowserInterfaceBindersForFrame(
   map->Add<network_hints::mojom::NetworkHintsHandler>(&BindNetworkHintsHandler);
   map->Add<content::rust_test::mojom::RustTestService>(
