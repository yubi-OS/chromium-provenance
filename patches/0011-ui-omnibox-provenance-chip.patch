diff --git a/chrome/browser/ui/views/location_bar/provenance_chip_view.cc b/chrome/browser/ui/views/location_bar/provenance_chip_view.cc
new file mode 100644
index 0000000000..ac612dbb77
--- /dev/null
+++ b/chrome/browser/ui/views/location_bar/provenance_chip_view.cc
@@ -0,0 +1,117 @@
+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+#include "chrome/browser/ui/views/location_bar/provenance_chip_view.h"
+
+#include "base/logging.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/views/chrome_typography.h"
+#include "chrome/browser/ui/views/location_bar/location_bar_view.h"
+#include "components/omnibox/browser/location_bar_model.h"
+#include "components/provenance_gate/browser/provenance_evidence_store.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/views/style/typography.h"
+#include "url/origin.h"
+
+namespace {
+
+// The persistent poll interval. LocationBarView::Update has no post-commit
+// firing (instrumented: it runs once, pre-commit, with a transiently empty
+// URL), so the chip tracks the DISPLAYED url on a timer. A map lookup plus
+// a string compare per tick per window is negligible.
+constexpr base::TimeDelta kPollInterval = base::Milliseconds(500);
+
+}  // namespace
+
+// Series 0011: relays evidence-store notifications to the chip through a
+// WeakPtr so a pending notification can never touch a destroyed chip.
+class ProvenanceChipView::EvidenceObserver
+    : public provenance_gate::ProvenanceEvidenceStore::Observer {
+ public:
+  explicit EvidenceObserver(base::WeakPtr<ProvenanceChipView> chip)
+      : chip_(std::move(chip)) {}
+  ~EvidenceObserver() override = default;
+
+  void OnEvidenceRecorded(const GURL& page_origin) override {
+    if (chip_) {
+      chip_->OnEvidenceRecorded(page_origin);
+    }
+  }
+
+ private:
+  base::WeakPtr<ProvenanceChipView> chip_;
+};
+
+ProvenanceChipView::ProvenanceChipView()
+    : views::Label(std::u16string(),
+                   CONTEXT_OMNIBOX_PRIMARY,
+                   views::style::STYLE_PRIMARY) {
+  SetVisible(false);
+  evidence_observer_ =
+      std::make_unique<EvidenceObserver>(weak_factory_.GetWeakPtr());
+  provenance_gate::ProvenanceEvidenceStore::Get().AddObserver(
+      evidence_observer_.get());
+}
+
+ProvenanceChipView::~ProvenanceChipView() {
+  provenance_gate::ProvenanceEvidenceStore::Get().RemoveObserver(
+      evidence_observer_.get());
+}
+
+void ProvenanceChipView::Update(content::WebContents* contents) {
+  // Immediate-refresh trigger only. Never clears chip state here: transient
+  // null updates (init, blocked navigations) must not hide an evidenced
+  // chip, and the persistent poll owns the displayed-URL tracking.
+  RefreshEvidence();
+}
+
+void ProvenanceChipView::OnEvidenceRecorded(const GURL& page_origin) {
+  if (url_.is_valid() &&
+      url::Origin::Create(url_) == url::Origin::Create(page_origin)) {
+    RefreshEvidence();
+  }
+}
+
+void ProvenanceChipView::RefreshEvidence() {
+  // The DISPLAYED url (LocationBarModel), not the last-committed one: on a
+  // blocked reload the omnibox keeps showing the attempted origin, and the
+  // chip should keep reporting it.
+  GURL url;
+  if (auto* location_bar = static_cast<LocationBarView*>(parent())) {
+    if (const LocationBarModel* model = location_bar->GetLocationBarModel()) {
+      url = model->GetURL();
+    }
+  }
+  const bool ai_detected =
+      url.is_valid() &&
+      !provenance_gate::ProvenanceEvidenceStore::Get()
+           .GetEvidenceForOrigin(url)
+           .empty();
+
+  // Log transitions only; the poll runs forever and per-tick logs would be
+  // noise.
+  if (url_ != url || ai_detected != last_ai_) {
+    VLOG(1) << "provenance_gate: chip url=" << url.spec()
+            << " ai=" << ai_detected;
+  }
+  url_ = url;
+  last_ai_ = ai_detected;
+
+  SetVisible(ai_detected);
+  if (ai_detected) {
+    SetText(u"AI CONTENT");
+    SetTooltipText(
+        u"A C2PA manifest on this page claims AI-generated content "
+        u"(unverified)");
+    SetEnabledColor(SkColorSetRGB(0xD9, 0x30, 0x25));
+  }
+
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&ProvenanceChipView::RefreshEvidence,
+                     weak_factory_.GetWeakPtr()),
+      kPollInterval);
+}
+
+BEGIN_METADATA(ProvenanceChipView)
+END_METADATA
diff --git a/chrome/browser/ui/views/location_bar/provenance_chip_view.h b/chrome/browser/ui/views/location_bar/provenance_chip_view.h
new file mode 100644
index 0000000000..83d040ee76
--- /dev/null
+++ b/chrome/browser/ui/views/location_bar/provenance_chip_view.h
@@ -0,0 +1,67 @@
+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+#ifndef CHROME_BROWSER_UI_VIEWS_LOCATION_BAR_PROVENANCE_CHIP_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_LOCATION_BAR_PROVENANCE_CHIP_VIEW_H_
+
+#include <memory>
+
+#include "base/memory/weak_ptr.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/controls/label.h"
+#include "url/gurl.h"
+
+namespace content {
+class WebContents;
+}
+
+namespace provenance_gate {
+class ProvenanceEvidenceStore;
+}
+
+// Series 0011: omnibox chip showing the provenance state of the URL the
+// location bar is DISPLAYING (via the LocationBarModel), so the chip stays
+// up through a blocked reload (the omnibox keeps showing the attempted
+// origin on the error page). v1 shows the chip only when recorded evidence
+// exists for that origin (e.g. a C2PA manifest claiming AI generation). The
+// chip reports what a manifest CLAIMS, not a verified fact (CONSTRAINTS.md
+// forbids "human-verified" claims); manifest signature validation lands
+// with the c2pa-rs vendoring follow-up.
+//
+// Refresh model: a persistent 500ms poll is the source of truth. There is
+// no reliable post-commit update hook for the location bar
+// (LocationBarView::Update fires once, pre-commit, with a transiently empty
+// URL — instrumented), so the chip tracks the displayed URL on a timer; a
+// map lookup + string compare per tick is negligible. The evidence store's
+// observer notification (UI thread) additionally refreshes the chip the
+// moment evidence lands, and Update() acts as an immediate-refresh trigger
+// only — it never clears chip state, because transient null updates
+// (init, blocked navigations) must not hide an evidenced chip.
+class ProvenanceChipView : public views::Label {
+ METADATA_HEADER(ProvenanceChipView, views::Label)
+
+ public:
+  ProvenanceChipView();
+  ~ProvenanceChipView() override;
+
+  ProvenanceChipView(const ProvenanceChipView&) = delete;
+  ProvenanceChipView& operator=(const ProvenanceChipView&) = delete;
+
+  // Immediate-refresh trigger (navigation / tab switch). Never clears
+  // state; the persistent poll owns the displayed-URL tracking.
+  void Update(content::WebContents* contents);
+
+ private:
+  // Subscribes to the evidence store so the chip refreshes the moment
+  // evidence for the displayed origin is recorded.
+  class EvidenceObserver;
+
+  void RefreshEvidence();
+  void OnEvidenceRecorded(const GURL& page_origin);
+
+  GURL url_;
+  bool last_ai_ = false;
+  std::unique_ptr<EvidenceObserver> evidence_observer_;
+  base::WeakPtrFactory<ProvenanceChipView> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_LOCATION_BAR_PROVENANCE_CHIP_VIEW_H_
diff --git a/components/provenance_gate/browser/provenance_evidence_store.cc b/components/provenance_gate/browser/provenance_evidence_store.cc
index 35f8e13d70..bcd5d1d723 100644
--- a/components/provenance_gate/browser/provenance_evidence_store.cc
+++ b/components/provenance_gate/browser/provenance_evidence_store.cc
@@ -10,12 +10,28 @@ ProvenanceEvidenceStore& ProvenanceEvidenceStore::Get() {
   return *instance;
 }
 
+void ProvenanceEvidenceStore::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void ProvenanceEvidenceStore::RemoveObserver(const Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
 void ProvenanceEvidenceStore::RecordEvidence(
     const GURL& page_origin,
     Evidence evidence) {
   const std::string key = url::Origin::Create(page_origin).Serialize();
-  base::AutoLock lock(lock_);
-  evidence_by_origin_[key].push_back(std::move(evidence));
+  {
+    base::AutoLock lock(lock_);
+    evidence_by_origin_[key].push_back(std::move(evidence));
+  }
+  // Series 0006: notify on the recording (UI) thread. The image scanner
+  // records evidence from the UI thread, so observers run on the UI thread
+  // too and no re-posting is needed.
+  for (Observer& observer : observers_) {
+    observer.OnEvidenceRecorded(page_origin);
+  }
 }
 
 std::vector<Evidence> ProvenanceEvidenceStore::GetEvidenceForOrigin(
diff --git a/components/provenance_gate/browser/provenance_evidence_store.h b/components/provenance_gate/browser/provenance_evidence_store.h
index 3a57d96cba..c80fb924b4 100644
--- a/components/provenance_gate/browser/provenance_evidence_store.h
+++ b/components/provenance_gate/browser/provenance_evidence_store.h
@@ -7,6 +7,8 @@
 #include <vector>
 
 #include "base/no_destructor.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
 #include "base/synchronization/lock.h"
 #include "components/provenance_gate/policy.h"
 #include "url/gurl.h"
@@ -20,10 +22,21 @@ namespace provenance_gate {
 // for the browser process lifetime.
 // Series 0010: moved from content/shell to components so the full chrome
 // browser and content_shell share one implementation.
+// Series 0006: Observers are notified on the recording (UI) thread when
+// evidence lands, so UI surfaces (the omnibox chip) can refresh without
+// polling or depending on LocationBarView::Update cadence.
 class ProvenanceEvidenceStore {
  public:
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnEvidenceRecorded(const GURL& page_origin) = 0;
+  };
+
   static ProvenanceEvidenceStore& Get();
 
+  void AddObserver(Observer* observer);
+  void RemoveObserver(const Observer* observer);
+
   void RecordEvidence(const GURL& page_origin, Evidence evidence);
   std::vector<Evidence> GetEvidenceForOrigin(const GURL& url);
 
@@ -33,6 +46,7 @@ class ProvenanceEvidenceStore {
 
   base::Lock lock_;
   std::map<std::string, std::vector<Evidence>> evidence_by_origin_;
+  base::ObserverList<Observer> observers_;
 };
 
 }  // namespace provenance_gate
