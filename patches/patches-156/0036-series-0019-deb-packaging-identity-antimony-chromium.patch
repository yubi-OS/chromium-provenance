Subject: [PATCH 36/39] =?UTF-8?q?series=200019:=20deb=20packaging=20identi?=
 =?UTF-8?q?ty=20=E2=80=94=20antimony=20(chromium-browser.info:=20PACKAGE?=
 =?UTF-8?q?=3Dantimony,=20INSTALLDIR=3D/opt/antimony,=20menu=20name,=20yub?=
 =?UTF-8?q?i-OS=20maintainer=20+=20URLs,=20RDN=20org.yubios.Antimony;=20BU?=
 =?UTF-8?q?ILD.gn=20linux=5Fpackage=20non-branded=20package=20name=20chrom?=
 =?UTF-8?q?ium-browser->antimony)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 chrome/installer/linux/BUILD.gn               |  2 +-
 .../linux/common/chromium-browser.info        | 24 +++++++++----------
 2 files changed, 13 insertions(+), 13 deletions(-)

diff --git a/chrome/installer/linux/BUILD.gn b/chrome/installer/linux/BUILD.gn
index 2a75b4c07d..648088130d 100644
--- a/chrome/installer/linux/BUILD.gn
+++ b/chrome/installer/linux/BUILD.gn
@@ -565,7 +565,7 @@ template("linux_package") {
   if (is_chrome_branded) {
     package = "google-chrome"
   } else {
-    package = "chromium-browser"
+    package = "antimony"
   }
 
   deb_target_name = "${target_name}_deb"
diff --git a/chrome/installer/linux/common/chromium-browser.info b/chrome/installer/linux/common/chromium-browser.info
index 395c019f7d..63d77e51fb 100644
--- a/chrome/installer/linux/common/chromium-browser.info
+++ b/chrome/installer/linux/common/chromium-browser.info
@@ -6,37 +6,37 @@
 # chromium-browser packages for various platforms.
 
 # Base name of the package.
-PACKAGE="chromium-browser"
+PACKAGE="antimony"
 
 # Filename of the main executable (for generating launcher scripts, etc.)
 PROGNAME=chrome
 
 # Base directory for package installation.
-INSTALLDIR=/opt/chromium.org/chromium
+INSTALLDIR=/opt/antimony
 
 # Directory for device policy enrollments.
-ENROLLMENTDIR=/etc/chromium/policies/enrollment
+ENROLLMENTDIR=/etc/antimony/policies/enrollment
 
 # Display string for desktop menu/icon.
-MENUNAME="Chromium Web Browser"
+MENUNAME="Antimony Web Browser"
 
 # Brief package description.
-SHORTDESC="The web browser from the Chromium projects"
+SHORTDESC="The provenance-gated web browser from the yubi-OS project"
 
 # Detailed package description.
-FULLDESC="Chromium is a browser that combines a minimal design with sophisticated technology to make the web faster, safer, and easier."
+FULLDESC="Antimony is a provenance-gated web browser built by yubi-OS: pages whose content claims AI generation without a trusted C2PA manifest are blocked or flagged, at every layer, by a YubiKey-rooted trust chain."
 
 # Package maintainer information.
-MAINTNAME="Chromium Linux Team"
-MAINTMAIL="chromium-packagers@chromium.org"
-PRODUCTURL="https://www.chromium.org/Home"
+MAINTNAME="yubi-OS"
+MAINTMAIL="foil-copy-overrate@duck.com"
+PRODUCTURL="https://github.com/yubi-OS"
 
 PROJECT_LICENSE="BSD-3-Clause and LGPL-2.1+ and Apache-2.0 and IJG and MIT and GPL-2.0+ and ISC and OpenSSL and (MPL-1.1 or GPL-2.0 or LGPL-2.0)"
 
-DEVELOPER_NAME="The Chromium Authors"
+DEVELOPER_NAME="yubi-OS"
 
-BUGTRACKERURL="https://www.chromium.org/for-testers/bug-reporting-guidelines"
+BUGTRACKERURL="https://github.com/yubi-OS/chromium-provenance/issues"
 
 HELPURL="https://chromium.googlesource.com/chromium/src/+/main/docs/linux/debugging.md"
 
-RDN="org.chromium.Chromium"
+RDN="org.yubios.Antimony"
