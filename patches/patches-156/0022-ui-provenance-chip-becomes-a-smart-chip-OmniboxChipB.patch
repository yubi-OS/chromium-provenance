From d4abfe7c6019d0abc328afb9a688efa1e2f0880f Mon Sep 17 00:00:00 2001
From: OMNI-AGENT <foil-copy-overrate@duck.com>
Date: Wed, 30 Sep 2026 14:49:43 -0700
Subject: [PATCH 22/39] ui: provenance chip becomes a smart chip -
 OmniboxChipButton pill (same class as the AI Mode chip), click opens
 chrome://settings/provenance in a new foreground tab, tooltip reports AI
 content blocking enabled per current mode (series 0011 fixup)

---
 .../location_bar/provenance_chip_view.cc      | 41 +++++++++++++++----
 .../views/location_bar/provenance_chip_view.h | 18 ++++----
 2 files changed, 44 insertions(+), 15 deletions(-)

diff --git a/chrome/browser/ui/views/location_bar/provenance_chip_view.cc b/chrome/browser/ui/views/location_bar/provenance_chip_view.cc
index 7a2fc3b5e9..ba9fe005d2 100644
--- a/chrome/browser/ui/views/location_bar/provenance_chip_view.cc
+++ b/chrome/browser/ui/views/location_bar/provenance_chip_view.cc
@@ -4,15 +4,16 @@
 #include "base/logging.h"
 #include "base/task/sequenced_task_runner.h"
 #include "base/time/time.h"
-#include "chrome/browser/ui/views/chrome_typography.h"
 #include "chrome/browser/profiles/profile.h"
 #include "chrome/browser/provenance/provenance_prefs_service_factory.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
 #include "chrome/browser/ui/views/location_bar/location_bar_view.h"
 #include "components/omnibox/browser/location_bar_model.h"
 #include "components/provenance_gate/browser/provenance_evidence_store.h"
+#include "components/provenance_gate/browser/provenance_policy_store.h"
 #include "content/public/browser/web_contents.h"
 #include "ui/base/metadata/metadata_impl_macros.h"
-#include "ui/views/style/typography.h"
 #include "url/origin.h"
 
 namespace {
@@ -45,9 +46,12 @@ class ProvenanceChipView::EvidenceObserver
 };
 
 ProvenanceChipView::ProvenanceChipView()
-    : views::Label(std::u16string(),
-                   CONTEXT_OMNIBOX_PRIMARY,
-                   views::style::STYLE_PRIMARY) {
+    : OmniboxChipButton(views::Button::PressedCallback(base::BindRepeating(
+          &ProvenanceChipView::OnChipPressed, base::Unretained(this)))) {
+  // The chip is a permanently expanded smart chip: OmniboxChipButton's
+  // collapse animation starts at zero (icon-only width); this chip has no
+  // icon, so start fully expanded.
+  ResetAnimation(1.0);
   SetVisible(false);
   evidence_observer_ =
       std::make_unique<EvidenceObserver>(weak_factory_.GetWeakPtr());
@@ -74,6 +78,24 @@ void ProvenanceChipView::OnEvidenceRecorded(const GURL& page_origin) {
   }
 }
 
+void ProvenanceChipView::OnChipPressed() {
+  content::WebContents* contents = nullptr;
+  if (auto* location_bar = static_cast<LocationBarView*>(parent())) {
+    contents = location_bar->GetWebContents();
+  }
+  if (!contents) {
+    return;
+  }
+  // The profile-based NavigateParams constructor picks the right browser
+  // window on this tree (browser_finder.h does not exist here).
+  NavigateParams params(
+      Profile::FromBrowserContext(contents->GetBrowserContext()),
+      GURL("chrome://settings/provenance"), ui::PAGE_TRANSITION_TYPED);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  // Navigate is in the global namespace on this tree (not chrome::).
+  ::Navigate(&params);
+}
+
 void ProvenanceChipView::RefreshEvidence() {
   // The DISPLAYED url (LocationBarModel), not the last-committed one: on a
   // blocked reload the omnibox keeps showing the attempted origin, and the
@@ -108,10 +130,13 @@ void ProvenanceChipView::RefreshEvidence() {
   SetVisible(ai_detected);
   if (ai_detected) {
     SetText(u"AI CONTENT");
+    // Series 0011 fixup: the tooltip reports the blocking mode - "AI content
+    // blocking enabled" when a blocking mode is set.
     SetTooltipText(
-        u"A C2PA manifest on this page claims AI-generated content "
-        u"(unverified)");
-    SetEnabledColor(SkColorSetRGB(0xD9, 0x30, 0x25));
+        provenance_gate::ProvenancePolicyStore::Get().mode() ==
+                provenance_gate::Mode::kOff
+            ? u"AI content blocking off"
+            : u"AI content blocking enabled");
   }
 
   base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
