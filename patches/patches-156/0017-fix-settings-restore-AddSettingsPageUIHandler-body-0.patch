From eff2a5432c9231bb0dacae59342a09013e61567e Mon Sep 17 00:00:00 2001
From: OMNI-AGENT <foil-copy-overrate@duck.com>
Date: Tue, 29 Sep 2026 23:58:58 -0700
Subject: [PATCH 17/39] fix(settings): restore AddSettingsPageUIHandler body -
 0016 shipped a self-recursive call; include missing prefs_service.h signature
 + router.ts PROVENANCE route (series 0016 fixup)

---
 chrome/browser/provenance/provenance_prefs_service.h | 2 +-
 chrome/browser/resources/settings/router.ts          | 1 +
 chrome/browser/ui/webui/settings/settings_ui.cc      | 2 +-
 3 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/provenance/provenance_prefs_service.h b/chrome/browser/provenance/provenance_prefs_service.h
index 0a43d08bbb..2ef9d1551f 100644
--- a/chrome/browser/provenance/provenance_prefs_service.h
+++ b/chrome/browser/provenance/provenance_prefs_service.h
@@ -29,7 +29,7 @@ class ProvenancePrefsService : public KeyedService {
  private:
   void SyncFromPrefs();
   void WriteExemptionsToPrefs();
-  void OnExemptionChanged(const std::string& origin_key);
+  void OnExemptionChanged(const std::string& origin_key, bool persistent);
 
   raw_ptr<PrefService> prefs_;
   PrefChangeRegistrar pref_change_registrar_;
diff --git a/chrome/browser/resources/settings/router.ts b/chrome/browser/resources/settings/router.ts
index 5c07af7bf6..ea8dd31de6 100644
--- a/chrome/browser/resources/settings/router.ts
+++ b/chrome/browser/resources/settings/router.ts
@@ -14,6 +14,7 @@ import {loadTimeData} from './i18n_setup.js';
  * Specifies all possible routes in settings.
  */
 export interface SettingsRoutes {
+  PROVENANCE?: Route;
   ABOUT: Route;
   ACCESSIBILITY: Route;
   ADDRESSES: Route;
diff --git a/chrome/browser/ui/webui/settings/settings_ui.cc b/chrome/browser/ui/webui/settings/settings_ui.cc
index cf07ee8c87..7fa7348c16 100644
--- a/chrome/browser/ui/webui/settings/settings_ui.cc
+++ b/chrome/browser/ui/webui/settings/settings_ui.cc
@@ -821,7 +821,7 @@ void SettingsUI::BindInterface(
 void SettingsUI::AddSettingsPageUIHandler(
     std::unique_ptr<content::WebUIMessageHandler> handler) {
   DCHECK(handler);
-  AddSettingsPageUIHandler(std::move(handler));
+  web_ui()->AddMessageHandler(std::move(handler));
 }
 
 void SettingsUI::TryShowHatsSurveyWithTimeout() {
