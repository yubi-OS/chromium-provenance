 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/chrome/browser/provenance/provenance_navigation_throttle.cc b/chrome/browser/provenance/provenance_navigation_throttle.cc
index 4b6d02ee5c..94b52ff519 100644
