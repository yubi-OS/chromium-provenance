+
+// Series 0007: mojom glue over the std-only provenance manifest parser.
+// Runs in the sandboxed data_decoder utility process.
+class ProvenanceInspectionImpl : public mojom::ProvenanceInspection {
+ public:
+  ProvenanceInspectionImpl() = default;
+  ~ProvenanceInspectionImpl() override = default;
+
+  ProvenanceInspectionImpl(const ProvenanceInspectionImpl&) = delete;
