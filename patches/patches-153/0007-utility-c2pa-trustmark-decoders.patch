+  Policy p; p.mode = Mode::kProvenanceRequired;
+  Decision d = Evaluate(p, {Ev(Signal::kC2paUnverifiedAiAction, 1.0, 0, "c2pa")});
+  EXPECT_FALSE(d.allow);
+  EXPECT_EQ(d.reason, "no_trusted_provenance");
+}
