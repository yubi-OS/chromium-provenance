new file mode 100644
index 0000000000..6ef9087cc1
--- /dev/null
+++ b/services/data_decoder/provenance_manifest_parser.h
@@ -0,0 +1,34 @@
+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+#ifndef SERVICES_DATA_DECODER_PROVENANCE_MANIFEST_PARSER_H_
+#define SERVICES_DATA_DECODER_PROVENANCE_MANIFEST_PARSER_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace data_decoder {
+
+// Series 0007, first cut: std-only C2PA manifest detector. Pure function, no
+// base/ dependencies, so it is standalone-testable without a Chromium build
+// (see provenance_manifest_parser_unittest.cc, -DSTANDALONE_TEST).
+//
+// Containers understood:
+//  - JPEG: APP11 (0xFFEB) segments carrying the JUMBF (ISO 19566-5) stream
+//  - PNG: caBX chunks carrying the JUMBF stream
+//
+// The manifest signature is NOT validated: this reports what the manifest
+// CLAIMS only. Callers must not treat it as trusted provenance.
+struct ProvenanceManifest {
+  bool found = false;
+  std::vector<std::string> claimed_actions;  // c2pa.actions/... URIs
+  std::string detail;                        // parser notes
+};
+
+// Scans |data| for an embedded C2PA manifest. Never reads out of bounds on
+// malformed input and never throws.
+ProvenanceManifest InspectProvenance(const uint8_t* data, size_t size);
+
+}  // namespace data_decoder
+
+#endif  // SERVICES_DATA_DECODER_PROVENANCE_MANIFEST_PARSER_H_
diff --git a/services/data_decoder/provenance_manifest_parser_unittest.cc b/services/data_decoder/provenance_manifest_parser_unittest.cc
new file mode 100644
index 0000000000..5f9321813a
--- /dev/null
+++ b/services/data_decoder/provenance_manifest_parser_unittest.cc
@@ -0,0 +1,153 @@
+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+// Builds under Chromium's gtest AND standalone (-DSTANDALONE_TEST) so the
+// parser can be exercised on the box without a full test-suite build.
+#include "services/data_decoder/provenance_manifest_parser.h"
+
+#ifdef STANDALONE_TEST
+#include <cassert>
+#include <cstdio>
+#include <string>
+#include <vector>
+#define TEST(a, b) static void a##_##b(); [[maybe_unused]] static int a##_##b##_reg = (a##_##b(), 0); static void a##_##b()
+#define EXPECT_TRUE(x) assert(x)
+#define EXPECT_FALSE(x) assert(!(x))
+#define EXPECT_EQ(a, b) assert((a) == (b))
+int main() { std::puts("provenance_manifest_parser tests: PASS"); return 0; }
+#else
+#include "testing/gtest/include/gtest/gtest.h"
+#endif
+
+namespace data_decoder {
+namespace {
+
+std::vector<uint8_t> Bytes(const std::string& s) {
+  return std::vector<uint8_t>(s.begin(), s.end());
+}
+
+std::vector<uint8_t> MakeBox(const char* type,
+                             const std::vector<uint8_t>& payload) {
+  std::vector<uint8_t> v;
+  const uint32_t len = static_cast<uint32_t>(payload.size() + 8);
+  v.push_back((len >> 24) & 0xFF);
+  v.push_back((len >> 16) & 0xFF);
+  v.push_back((len >> 8) & 0xFF);
+  v.push_back(len & 0xFF);
+  for (int i = 0; i < 4; i++) {
+    v.push_back(static_cast<uint8_t>(type[i]));
+  }
+  v.insert(v.end(), payload.begin(), payload.end());
+  return v;
+}
+
+// Minimal JUMBF: one "jumd" superbox wrapping one "json" content box.
+std::vector<uint8_t> JumbfWithJson(const std::string& json) {
+  return MakeBox("jumd", MakeBox("json", Bytes(json)));
+}
+
+std::vector<uint8_t> JpegWithApp11(const std::vector<uint8_t>& jumbf) {
+  std::vector<uint8_t> v = {0xFF, 0xD8};  // SOI
+  const uint32_t seg = static_cast<uint32_t>(jumbf.size() + 2);
+  v.push_back(0xFF);
+  v.push_back(0xEB);  // APP11
+  v.push_back((seg >> 8) & 0xFF);
+  v.push_back(seg & 0xFF);
+  v.insert(v.end(), jumbf.begin(), jumbf.end());
+  v.push_back(0xFF);
+  v.push_back(0xD9);  // EOI
+  return v;
+}
+
+std::vector<uint8_t> PngWithCaBx(const std::vector<uint8_t>& jumbf) {
+  std::vector<uint8_t> v = {0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A};
+  auto push32 = [&v](uint32_t x) {
+    v.push_back((x >> 24) & 0xFF);
+    v.push_back((x >> 16) & 0xFF);
+    v.push_back((x >> 8) & 0xFF);
+    v.push_back(x & 0xFF);
+  };
+  push32(static_cast<uint32_t>(jumbf.size()));
+  v.insert(v.end(), {'c', 'a', 'B', 'X'});
+  v.insert(v.end(), jumbf.begin(), jumbf.end());
+  push32(0);  // CRC placeholder; the parser ignores CRC
+  push32(0);  // IEND chunk length 0
+  v.insert(v.end(), {'I', 'E', 'N', 'D'});
+  return v;
+}
+
+const char* kAiJson =
+    "{\"actions\":{\"actions\":[{\"action\":\"c2pa.actions/"
+    "trainedAlgorithmicMedia\"}]}}";
+
+TEST(ProvenanceManifestParser, JpegApp11_ManifestFoundWithAction) {
+  auto jpeg = JpegWithApp11(JumbfWithJson(kAiJson));
+  ProvenanceManifest m = InspectProvenance(jpeg.data(), jpeg.size());
+  EXPECT_TRUE(m.found);
+  EXPECT_EQ(m.claimed_actions.size(), 1u);
+  EXPECT_EQ(m.claimed_actions[0], "c2pa.actions/trainedAlgorithmicMedia");
+}
+
+TEST(ProvenanceManifestParser, Jpeg_NoApp11_NoManifest) {
+  std::vector<uint8_t> jpeg = {0xFF, 0xD8, 0xFF, 0xD9};
+  ProvenanceManifest m = InspectProvenance(jpeg.data(), jpeg.size());
+  EXPECT_FALSE(m.found);
+  EXPECT_TRUE(m.claimed_actions.empty());
+}
+
+TEST(ProvenanceManifestParser, Jpeg_PlainAppSegment_NoJson) {
+  std::vector<uint8_t> v = {0xFF, 0xD8};
+  v.push_back(0xFF);
+  v.push_back(0xE1);
+  v.push_back(0x00);
+  v.push_back(0x04);  // APP1, length 4, empty payload
+  v.push_back(0xFF);
+  v.push_back(0xD9);
+  ProvenanceManifest m = InspectProvenance(v.data(), v.size());
+  EXPECT_FALSE(m.found);
+}
+
+TEST(ProvenanceManifestParser, Png_CaBx_ManifestFound) {
+  auto png = PngWithCaBx(JumbfWithJson(kAiJson));
+  ProvenanceManifest m = InspectProvenance(png.data(), png.size());
+  EXPECT_TRUE(m.found);
+  EXPECT_EQ(m.claimed_actions.size(), 1u);
+}
+
+TEST(ProvenanceManifestParser, Png_NoCaBx_NoManifest) {
+  std::vector<uint8_t> png = {0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A};
+  ProvenanceManifest m = InspectProvenance(png.data(), png.size());
+  EXPECT_FALSE(m.found);
+}
+
+TEST(ProvenanceManifestParser, MultipleActions_AllExtracted) {
+  std::string json =
+      "{\"actions\":{\"actions\":["
+      "{\"action\":\"c2pa.actions/edited\"},"
+      "{\"action\":\"c2pa.actions/trainedAlgorithmicMedia\"}]}}";
+  auto jpeg = JpegWithApp11(JumbfWithJson(json));
+  ProvenanceManifest m = InspectProvenance(jpeg.data(), jpeg.size());
+  EXPECT_TRUE(m.found);
+  EXPECT_EQ(m.claimed_actions.size(), 2u);
+}
+
+TEST(ProvenanceManifestParser, JsonWithoutActions_FoundButEmpty) {
+  auto jpeg = JpegWithApp11(JumbfWithJson("{\"note\":\"no actions here\"}"));
+  ProvenanceManifest m = InspectProvenance(jpeg.data(), jpeg.size());
+  EXPECT_TRUE(m.found);
+  EXPECT_TRUE(m.claimed_actions.empty());
+}
+
+TEST(ProvenanceManifestParser, TruncatedJpeg_Safe) {
+  auto jpeg = JpegWithApp11(JumbfWithJson(kAiJson));
+  jpeg.resize(jpeg.size() / 2);  // cut mid-stream
+  ProvenanceManifest m = InspectProvenance(jpeg.data(), jpeg.size());
+  EXPECT_FALSE(m.found);
+}
+
+TEST(ProvenanceManifestParser, Garbage_Safe) {
+  std::vector<uint8_t> junk(4096, 0xAB);
+  ProvenanceManifest m = InspectProvenance(junk.data(), junk.size());
+  EXPECT_FALSE(m.found);
+}
+
+}  // namespace
+}  // namespace data_decoder
