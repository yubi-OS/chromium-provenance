diff --git a/services/data_decoder/provenance_manifest_parser.cc b/services/data_decoder/provenance_manifest_parser.cc
new file mode 100644
index 0000000000..2edd0a326f
--- /dev/null
+++ b/services/data_decoder/provenance_manifest_parser.cc
@@ -0,0 +1,208 @@
+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+#include "services/data_decoder/provenance_manifest_parser.h"
+
+#include <string>
+#include <vector>
+
+namespace data_decoder {
+
+namespace {
+
+// JUMBF-in-JPEG segments may carry an 11-byte chunk header each; if the
+// concatenated APP11 stream does not parse as boxes, we retry past one
+// header.
+constexpr size_t kJumbfChunkHeaderSize = 11;
+
+bool FourCc(const uint8_t* p, const char* s) {
+  for (int i = 0; i < 4; i++) {
+    if (p[i] != static_cast<uint8_t>(s[i])) {
+      return false;
+    }
+  }
+  return true;
+}
+
+uint32_t ReadBe32(const uint8_t* p) {
+  return (static_cast<uint32_t>(p[0]) << 24) |
+         (static_cast<uint32_t>(p[1]) << 16) |
+         (static_cast<uint32_t>(p[2]) << 8) | static_cast<uint32_t>(p[3]);
+}
+
+// Collects the payload bytes of every JPEG APP11 segment (the JUMBF carrier
+// per C2PA). Walks markers from the SOI; stops at SOS/EOI/truncation.
+std::vector<uint8_t> CollectJpegApp11(const uint8_t* data, size_t size,
+                                      size_t* segments) {
+  std::vector<uint8_t> out;
+  *segments = 0;
+  size_t off = 2;  // past SOI
+  while (off + 4 <= size) {
+    if (data[off] != 0xFF) {
+      break;
+    }
+    const uint8_t marker = data[off + 1];
+    if (marker == 0x01 || (marker >= 0xD0 && marker <= 0xD9)) {
+      if (marker == 0xD9) {
+        break;  // EOI
+      }
+      off += 2;
+      continue;
+    }
+    const uint32_t seg_len = (static_cast<uint32_t>(data[off + 2]) << 8) |
+                             static_cast<uint32_t>(data[off + 3]);
+    if (seg_len < 2 || off + 2 + seg_len > size) {
+      break;  // truncated: stop scanning
+    }
+    if (marker == 0xEB) {  // APP11
+      out.insert(out.end(), data + off + 4, data + off + 2 + seg_len);
+      (*segments)++;
+    }
+    off += 2 + seg_len;
+    if (marker == 0xDA) {
+      break;  // entropy-coded data follows; no more APP11
+    }
+  }
+  return out;
+}
+
+// Collects caBX chunk payloads (C2PA JUMBF carrier in PNG).
+std::vector<uint8_t> CollectPngCaBx(const uint8_t* data, size_t size,
+                                    size_t* chunks) {
+  std::vector<uint8_t> out;
+  *chunks = 0;
+  static const uint8_t kPngSig[8] = {0x89, 0x50, 0x4E, 0x47,
+                                     0x0D, 0x0A, 0x1A, 0x0A};
+  if (size < 8) {
+    return out;
+  }
+  for (int i = 0; i < 8; i++) {
+    if (data[i] != kPngSig[i]) {
+      return out;
+    }
+  }
+  size_t off = 8;
+  while (off + 12 <= size) {
+    const uint32_t len = ReadBe32(data + off);
+    if (off + 8 + len + 4 > size) {
+      break;  // truncated
+    }
+    const uint8_t* type = data + off + 4;
+    if (FourCc(type, "caBX")) {
+      out.insert(out.end(), data + off + 8, data + off + 8 + len);
+      (*chunks)++;
+    }
+    if (FourCc(type, "IEND")) {
+      break;
+    }
+    off += 8 + len + 4;
+  }
+  return out;
+}
+
+// Depth-limited JUMBF box walk collecting every "json" content-box payload.
+void WalkBoxes(const uint8_t* p, size_t size, int depth,
+               std::vector<std::string>* json_payloads) {
+  if (depth > 8) {
+    return;
+  }
+  size_t off = 0;
+  while (off + 8 <= size) {
+    const uint32_t len = ReadBe32(p + off);
+    if (len < 8 || off + len > size) {
+      return;  // implausible box: stop walking
+    }
+    const uint8_t* type = p + off + 4;
+    if (FourCc(type, "json")) {
+      json_payloads->emplace_back(reinterpret_cast<const char*>(p + off + 8),
+                                  len - 8);
+    } else if (FourCc(type, "jumd") || FourCc(type, "jumb")) {
+      WalkBoxes(p + off + 8, len - 8, depth + 1, json_payloads);
+    }
+    off += len;
+  }
+}
+
+// Extracts every "action":"..." string value that looks like a C2PA action
+// URI. Minimal extraction, no JSON dependency.
+void ExtractActions(const std::string& json, std::vector<std::string>* out) {
+  const std::string key = "\"action\"";
+  size_t pos = 0;
+  while ((pos = json.find(key, pos)) != std::string::npos) {
+    const size_t colon = json.find(':', pos + key.size());
+    if (colon == std::string::npos) {
+      break;
+    }
+    const size_t q1 = json.find('"', colon);
+    if (q1 == std::string::npos) {
+      break;
+    }
+    std::string value;
+    size_t i = q1 + 1;
+    while (i < json.size() && json[i] != '"') {
+      if (json[i] == '\\' && i + 1 < json.size()) {
+        value += json[i];
+        value += json[i + 1];
+        i += 2;
+        continue;
+      }
+      value += json[i];
+      i++;
+    }
+    if (i >= json.size()) {
+      break;
+    }
+    if (!value.empty() && value.find("c2pa.actions/") != std::string::npos) {
+      out->push_back(value);
+    }
+    pos = i;
+  }
+}
+
+}  // namespace
+
+ProvenanceManifest InspectProvenance(const uint8_t* data, size_t size) {
+  ProvenanceManifest m;
+  std::vector<uint8_t> jumbf;
+  if (size >= 2 && data[0] == 0xFF && data[1] == 0xD8) {
+    size_t segments = 0;
+    jumbf = CollectJpegApp11(data, size, &segments);
+    m.detail = "jpeg app11 segments=" + std::to_string(segments) +
+               " jumbf_bytes=" + std::to_string(jumbf.size());
+  } else if (size >= 8 && data[0] == 0x89 && data[1] == 0x50) {
+    size_t chunks = 0;
+    jumbf = CollectPngCaBx(data, size, &chunks);
+    m.detail = "png caBX chunks=" + std::to_string(chunks) +
+               " jumbf_bytes=" + std::to_string(jumbf.size());
+  } else {
+    m.detail = "container not recognized";
+    return m;
+  }
+  if (jumbf.empty()) {
+    m.detail += "; no jumbf payload";
+    return m;
+  }
+
+  std::vector<std::string> jsons;
+  // JUMBF-in-JPEG chunk headers observed in the wild: none (offset 0),
+  // 8-byte "JP" + version + chunk-index header (c2pa-rs writer), or the
+  // 11-byte ISO variant. Try each; first framing that yields boxes wins.
+  static const size_t kHeaderSkips[] = {0, 8, 11};
+  for (size_t skip : kHeaderSkips) {
+    if (jumbf.size() <= skip) {
+      break;
+    }
+    jsons.clear();
+    WalkBoxes(jumbf.data() + skip, jumbf.size() - skip, 0, &jsons);
+    if (!jsons.empty()) {
+      m.detail += " (header-skip=" + std::to_string(skip) + ")";
+      break;
+    }
+  }
+
+  m.found = !jsons.empty();
+  for (const std::string& j : jsons) {
+    ExtractActions(j, &m.claimed_actions);
+  }
+  return m;
+}
+
+}  // namespace data_decoder
\ No newline at end of file
