@@ -0,0 +1,25 @@
+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+
+module data_decoder.mojom;
+
+import "mojo/public/mojom/base/big_buffer.mojom";
+
+// Series 0007: image provenance inspection in the sandboxed data_decoder
+// utility process. First cut: detects C2PA manifests (JPEG APP11/JUMBF, PNG
+// caBX chunks) and extracts the action names the manifest claims. The
+// manifest signature is NOT validated here: a positive result means
+// "a manifest claims X", never "X is trusted". Signature/trust validation
+// lands with the vendored c2pa-rs follow-up (SERIES.md 0007).
+struct ProvenanceImageInspection {
+  // A C2PA JUMBF manifest was found.
+  bool has_manifest;
+  // Action URIs the manifest claims (e.g. c2pa.actions/trainedAlgorithmicMedia).
+  array<string> claimed_actions;
+  // Parser notes (container type, bytes scanned, errors).
+  string detail;
+};
+
+interface ProvenanceInspection {
+  InspectImage(mojo_base.mojom.BigBuffer data)
+      => (ProvenanceImageInspection result);
+};
