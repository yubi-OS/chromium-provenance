+#include "services/data_decoder/provenance_inspection_impl.h"
+
+#include <utility>
+
+#include "mojo/public/cpp/base/big_buffer.h"
+#include "services/data_decoder/provenance_manifest_parser.h"
+
+namespace data_decoder {
+
+void ProvenanceInspectionImpl::InspectImage(mojo_base::BigBuffer data,
+                                            InspectImageCallback callback) {
+  auto result = mojom::ProvenanceImageInspection::New();
+  const ProvenanceManifest manifest =
+      InspectProvenance(data.data(), data.size());
+  result->has_manifest = manifest.found;
+  result->claimed_actions = manifest.claimed_actions;
+  result->detail = manifest.detail;
+  std::move(callback).Run(std::move(result));
+}
+
+}  // namespace data_decoder
