From 800365457d46b6053e7c6272e076ee850313f3d3 Mon Sep 17 00:00:00 2001
From: OMNI-AGENT <foil-copy-overrate@duck.com>
Date: Mon, 28 Sep 2026 01:15:30 -0700
Subject: [PATCH 4/4] policy: --provenance-mode switch for content_shell

Series 0005 (content_shell adaptation): the provenance Policy comes
from a --provenance-mode=block-on-detect|provenance-required switch.
chrome prefs + enterprise policy templates land with the chrome port.
Validated: mode A allows (no_signal), mode B fails closed
(no_trusted_provenance, ERR_BLOCKED_BY_CLIENT).
---
 content/shell/browser/shell_content_browser_client.cc | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/content/shell/browser/shell_content_browser_client.cc b/content/shell/browser/shell_content_browser_client.cc
index c8b7c0efd6..a92004dba9 100644
--- a/content/shell/browser/shell_content_browser_client.cc
+++ b/content/shell/browser/shell_content_browser_client.cc
@@ -417,8 +417,14 @@ ShellContentBrowserClient::CreateURLLoaderThrottles(
         std::make_unique<custom_handlers::ProtocolHandlerThrottle>(*factory));
   }
 
-  result.push_back(std::make_unique<ProvenanceGateThrottle>(
-      provenance_gate::Policy{}));
+  // Series 0005 (content_shell adaptation): policy via command-line switch.
+  // chrome/prefs + enterprise policy templates land with the chrome port.
+  provenance_gate::Policy pg_policy;
+  const auto* pg_cmd = base::CommandLine::ForCurrentProcess();
+  if (pg_cmd->GetSwitchValueASCII("provenance-mode") == "provenance-required") {
+    pg_policy.mode = provenance_gate::Mode::kProvenanceRequired;
+  }
+  result.push_back(std::make_unique<ProvenanceGateThrottle>(pg_policy));
 
   return result;
 }
