+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "url/gurl.h"
+
+namespace content {
+class BrowserContext;
+class RenderFrameHost;
+}
+
+namespace provenance_gate {
+
+// Series 0004: browser-side store of reported page text. UI-thread only
+// (frame-bound interfaces bind there). Detector adapters read this to build
+// Evidence.
+// Series 0010: moved from content/shell to components so the full chrome
+// browser and content_shell share one implementation.
+class ProvenancePageTextStore {
+ public:
+  static ProvenancePageTextStore& Get() {
+    static base::NoDestructor<ProvenancePageTextStore> instance;
+    return *instance;
+  }
+
+  void Record(const GURL& url, const std::string& text) {
+    const size_t chars = text.size();
+    const bool above_floor = chars >= Policy().classifier_min_chars;
+    pages_[url.spec()] = text;
+    VLOG(1) << "provenance_gate: page_text url=" << url.spec()
+            << " chars=" << chars << " above_floor=" << above_floor;
+  }
+
+ private:
+  std::map<std::string, std::string> pages_;
+};
+
+// Series 0008: receives page text and <img> URLs over mojo, records the
+// text, and hands the image URLs to the page-image scanner (browser-side
+// C2PA manifest inspection).
+class ProvenancePageTextImpl : public mojom::ProvenancePageText {
+ public:
+  explicit ProvenancePageTextImpl(content::BrowserContext* browser_context)
+      : browser_context_(browser_context) {}
+
+  void ReportPageText(const std::string& frame_url,
+                      const std::string& text) override {
+    ProvenancePageTextStore::Get().Record(GURL(frame_url), text);
+  }
+
+  void ReportPageImages(
+      const std::string& frame_url,
+      const std::vector<std::string>& image_urls) override {
+    // Series 0008: hand the page's <img> URLs to the image scanner; it
+    // fetches the bytes, runs the sandboxed C2PA manifest inspection
+    // (Series 0007), and records per-origin Evidence when the manifest
+    // claims AI generation.
+    image_scanner_ =
+        std::make_unique<ProvenancePageImageScanner>(browser_context_);
+    image_scanner_->Scan(GURL(frame_url), image_urls);
+  }
+
+ private:
+  raw_ptr<content::BrowserContext> browser_context_;
+  std::unique_ptr<ProvenancePageImageScanner> image_scanner_;
+};
+
+// Frame-bound binder: exposed via RegisterBrowserInterfaceBindersForFrame
+// by both content_shell and chrome (Series 0010 chrome integration).
+void BindProvenancePageText(
+    content::RenderFrameHost* render_frame_host,
+    mojo::PendingReceiver<mojom::ProvenancePageText> receiver);
+
+}  // namespace provenance_gate
+
+#endif  // COMPONENTS_PROVENANCE_GATE_BROWSER_PROVENANCE_PAGE_TEXT_SERVICE_H_
