+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+#ifndef COMPONENTS_PROVENANCE_GATE_BROWSER_PROVENANCE_GATE_THROTTLE_H_
+#define COMPONENTS_PROVENANCE_GATE_BROWSER_PROVENANCE_GATE_THROTTLE_H_
+
+#include "components/provenance_gate/policy.h"
+#include "third_party/blink/public/common/loader/url_loader_throttle.h"
+
+namespace provenance_gate {
+
+// Series 0002/0003: main-frame provenance gate. Evaluates the provenance
+// policy on responses and cancels loads the policy disallows. Detector
+// adapters supply Evidence via the ProvenanceEvidenceStore; with no
+// evidence Mode A allows everything, Mode B (provenance_required) fails
+// closed and cancels the load.
+// Series 0010: moved from content/shell to components so the full chrome
+// browser and content_shell share one implementation.
+class ProvenanceGateThrottle : public blink::URLLoaderThrottle {
+ public:
+  explicit ProvenanceGateThrottle(const Policy& policy);
+  ~ProvenanceGateThrottle() override;
+
+  // blink::URLLoaderThrottle:
+  void DetachFromCurrentSequence() override;
+  void WillProcessResponse(
+      const GURL& response_url,
+      network::mojom::URLResponseHead* response_head,
+      bool* defer) override;
+
+ private:
+  Policy policy_;
+};
+
+}  // namespace provenance_gate
+
+#endif  // COMPONENTS_PROVENANCE_GATE_BROWSER_PROVENANCE_GATE_THROTTLE_H_
