diff --git a/chrome/browser/provenance/provenance_navigation_throttle.cc b/chrome/browser/provenance/provenance_navigation_throttle.cc
new file mode 100644
index 0000000000..71a2d4a376
--- /dev/null
+++ b/chrome/browser/provenance/provenance_navigation_throttle.cc
@@ -0,0 +1,144 @@
+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+#include "chrome/browser/provenance/provenance_navigation_throttle.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/logging.h"
+#include "base/strings/stringprintf.h"
+#include "components/provenance_gate/browser/provenance_bypass_store.h"
+#include "components/provenance_gate/browser/provenance_evidence_store.h"
+#include "content/public/browser/navigation_handle.h"
+#include "net/base/net_errors.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace provenance {
+
+namespace {
+
+// Marker query param appended by the Proceed button; the gate throttle
+// adopts it into the ProvenanceBypassStore and allows the load.
+constexpr const char kBypassMarker[] = "__provenance_bypass=1";
+
+bool ProvenanceRequiredMode() {
+  return base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+             "provenance-mode") == "provenance-required";
+}
+
+std::string EscapeHTML(const std::string& in) {
+  std::string out;
+  out.reserve(in.size());
+  for (const char c : in) {
+    switch (c) {
+      case '<':
+        out += "&lt;";
+        break;
+      case '>':
+        out += "&gt;";
+        break;
+      case '&':
+        out += "&amp;";
+        break;
+      case '"':
+        out += "&quot;";
+        break;
+      case '\'':
+        out += "&#39;";
+        break;
+      default:
+        out.push_back(c);
+    }
+  }
+  return out;
+}
+
+// The Proceed button carries the bypass command in the URL itself: the gate
+// throttle adopts the marker into the ProvenanceBypassStore and allows the
+// load. No error-page JS command channel needed for v1.
+std::string BuildProvenanceInterstitialHtml(
+    const GURL& url,
+    const provenance_gate::Evidence& evidence,
+    bool overridable) {
+  const std::string escaped_origin =
+      EscapeHTML(url::Origin::Create(url).Serialize());
+  std::string proceed_target = url.spec();
+  proceed_target += url.has_query() ? "&" : "?";
+  proceed_target += kBypassMarker;
+
+  std::string buttons;
+  if (overridable) {
+    buttons = base::StringPrintf(
+        "<p style=\"margin-top:24px;\">"
+        "<a href=\"%s\" style=\"background:#c52219;color:#fff;"
+        "padding:10px 20px;border-radius:6px;text-decoration:none;"
+        "font-weight:600;\">Proceed anyway</a> "
+        "<span style=\"color:#8b93b8;font-size:12px;\">"
+        "(adds this origin to the session bypass list)</span></p>",
+        EscapeHTML(proceed_target).c_str());
+  }
+
+  return base::StringPrintf(
+      "<!DOCTYPE html><html><head><meta charset=\"utf-8\">"
+      "<title>Provenance gate</title></head>"
+      "<body style=\"margin:0;font-family:sans-serif;"
+      "background:#0B1026;color:#e8e8ef;\">"
+      "<div style=\"max-width:620px;margin:10vh auto;padding:0 24px;\">"
+      "<div style=\"background:#3a0d0d;border:1px solid #c52219;"
+      "border-radius:10px;padding:18px 24px;\">"
+      "<div style=\"color:#ff6b5e;font-weight:700;font-size:22px;\">"
+      "AI content detected</div></div>"
+      "<div style=\"background:#141a33;border-radius:10px;"
+      "padding:22px 24px;margin-top:14px;\">"
+      "<p style=\"line-height:1.5;\">A C2PA manifest on "
+      "<code style=\"color:#9fd0ff;\">%s</code> claims this content was "
+      "AI-generated. The claim is <b>unverified</b> (manifest signatures are "
+      "not validated yet).</p>"
+      "<p style=\"color:#8b93b8;font-size:13px;\">"
+      "signal: c2pa_unverified_ai_action &middot; source: %s &middot; "
+      "confidence: %.2f</p>"
+      "%s"
+      "</div></div></body></html>",
+      escaped_origin.c_str(), EscapeHTML(evidence.source).c_str(),
+      evidence.confidence, buttons.c_str());
+}
+
+}  // namespace
+
+ProvenanceNavigationThrottle::ProvenanceNavigationThrottle(
+    content::NavigationThrottleRegistry& registry)
+    : content::NavigationThrottle(registry) {}
+
+ProvenanceNavigationThrottle::~ProvenanceNavigationThrottle() = default;
+
+content::NavigationThrottle::ThrottleCheckResult
+ProvenanceNavigationThrottle::WillFailRequest() {
+  content::NavigationHandle* handle = navigation_handle();
+  if (handle->GetNetErrorCode() != net::ERR_BLOCKED_BY_CLIENT ||
+      !handle->IsInPrimaryMainFrame()) {
+    return content::NavigationThrottle::PROCEED;
+  }
+  const GURL url = handle->GetURL();
+  const std::vector<provenance_gate::Evidence> evidence =
+      provenance_gate::ProvenanceEvidenceStore::Get().GetEvidenceForOrigin(url);
+  if (evidence.empty()) {
+    return content::NavigationThrottle::PROCEED;
+  }
+  const bool overridable = !ProvenanceRequiredMode();
+  VLOG(1) << "provenance_gate: interstitial url=" << url.spec()
+          << " overridable=" << overridable;
+  std::optional<std::string> html =
+      BuildProvenanceInterstitialHtml(url, evidence.front(), overridable);
+  return content::NavigationThrottle::ThrottleCheckResult(
+      content::NavigationThrottle::CANCEL, net::ERR_BLOCKED_BY_CLIENT,
+      std::move(html));
+}
+
+const char* ProvenanceNavigationThrottle::GetNameForLogging() {
+  return "ProvenanceNavigationThrottle";
+}
+
+}  // namespace provenance
diff --git a/chrome/browser/provenance/provenance_navigation_throttle.h b/chrome/browser/provenance/provenance_navigation_throttle.h
new file mode 100644
index 0000000000..ab3dbfab89
--- /dev/null
+++ b/chrome/browser/provenance/provenance_navigation_throttle.h
@@ -0,0 +1,34 @@
+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+#ifndef CHROME_BROWSER_PROVENANCE_PROVENANCE_NAVIGATION_THROTTLE_H_
+#define CHROME_BROWSER_PROVENANCE_PROVENANCE_NAVIGATION_THROTTLE_H_
+
+#include "content/public/browser/navigation_throttle.h"
+
+namespace provenance {
+
+// Series 0012: replaces the bare ERR_BLOCKED_BY_CLIENT error page with a
+// provenance interstitial when the gate blocks a main-frame navigation and
+// the evidence store has recorded AI-content evidence for the origin. The
+// interstitial shows the signal, its source and confidence, and (in
+// block_on_detect mode, where the policy marks the block overridable) a
+// Proceed button that navigates to the URL with a bypass marker; the gate
+// throttle adopts the marker into the ProvenanceBypassStore and allows.
+// provenance_required mode fails closed: no proceed.
+class ProvenanceNavigationThrottle : public content::NavigationThrottle {
+ public:
+  explicit ProvenanceNavigationThrottle(
+      content::NavigationThrottleRegistry& registry);
+  ~ProvenanceNavigationThrottle() override;
+
+  ProvenanceNavigationThrottle(const ProvenanceNavigationThrottle&) = delete;
+  ProvenanceNavigationThrottle& operator=(const ProvenanceNavigationThrottle&) =
+      delete;
+
+  // content::NavigationThrottle:
+  ThrottleCheckResult WillFailRequest() override;
+  const char* GetNameForLogging() override;
+};
+
+}  // namespace provenance
+
+#endif  // CHROME_BROWSER_PROVENANCE_PROVENANCE_NAVIGATION_THROTTLE_H_
