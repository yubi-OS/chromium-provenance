diff --git a/components/provenance_gate/browser/provenance_bypass_store.cc b/components/provenance_gate/browser/provenance_bypass_store.cc
new file mode 100644
index 0000000000..2ac001a99d
--- /dev/null
+++ b/components/provenance_gate/browser/provenance_bypass_store.cc
@@ -0,0 +1,43 @@
+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+#include "components/provenance_gate/browser/provenance_bypass_store.h"
+
+#include "url/origin.h"
+
+namespace provenance_gate {
+
+namespace {
+// Marker query param the interstitial's Proceed button appends to the
+// blocked URL. Seeing it both signals "user chose to proceed" and carries
+// the command without needing an error-page JS command channel (v1).
+constexpr const char kBypassMarker[] = "__provenance_bypass=1";
+}  // namespace
+
+ProvenanceBypassStore& ProvenanceBypassStore::Get() {
+  static base::NoDestructor<ProvenanceBypassStore> instance;
+  return *instance;
+}
+
+bool ProvenanceBypassStore::MaybeAdoptBypassRequest(const GURL& url) {
+  if (!url.is_valid() ||
+      url.query().find(kBypassMarker) == std::string::npos) {
+    return false;
+  }
+  GURL::Replacements replacements;
+  replacements.ClearQuery();
+  const std::string origin_key =
+      url::Origin::Create(url.ReplaceComponents(replacements)).Serialize();
+  base::AutoLock lock(lock_);
+  bypassed_origins_.insert(origin_key);
+  return true;
+}
+
+bool ProvenanceBypassStore::IsBypassed(const GURL& url) {
+  if (!url.is_valid()) {
+    return false;
+  }
+  const std::string origin_key = url::Origin::Create(url).Serialize();
+  base::AutoLock lock(lock_);
+  return bypassed_origins_.contains(origin_key);
+}
+
+}  // namespace provenance_gate
diff --git a/components/provenance_gate/browser/provenance_bypass_store.h b/components/provenance_gate/browser/provenance_bypass_store.h
new file mode 100644
index 0000000000..81b0ec552c
--- /dev/null
+++ b/components/provenance_gate/browser/provenance_bypass_store.h
@@ -0,0 +1,39 @@
+// Copyright 2026 The yubi-OS Authors. BSD-3-Clause (matches Chromium).
+#ifndef COMPONENTS_PROVENANCE_GATE_BROWSER_PROVENANCE_BYPASS_STORE_H_
+#define COMPONENTS_PROVENANCE_GATE_BROWSER_PROVENANCE_BYPASS_STORE_H_
+
+#include <set>
+#include <string>
+
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "url/gurl.h"
+
+namespace provenance_gate {
+
+// Series 0012: in-memory store of origins the user chose to proceed to after
+// a provenance-gate block ("Proceed anyway"). Written when the gate throttle
+// sees a bypass-marked navigation, read by the throttle before policy
+// evaluation. In-memory only, browser-process lifetime. Mode
+// provenance_required never consults this store (fails closed).
+class ProvenanceBypassStore {
+ public:
+  static ProvenanceBypassStore& Get();
+
+  // If `url` carries the bypass marker query param, records the origin
+  // (sans param) as bypassed and returns true.
+  bool MaybeAdoptBypassRequest(const GURL& url);
+
+  bool IsBypassed(const GURL& url);
+
+ private:
+  friend class base::NoDestructor<ProvenanceBypassStore>;
+  ProvenanceBypassStore() = default;
+
+  base::Lock lock_;
+  std::set<std::string> bypassed_origins_;
+};
+
+}  // namespace provenance_gate
+
+#endif  // COMPONENTS_PROVENANCE_GATE_BROWSER_PROVENANCE_BYPASS_STORE_H_
diff --git a/components/provenance_gate/browser/provenance_gate_throttle.cc b/components/provenance_gate/browser/provenance_gate_throttle.cc
index a966cf0961..15324ec1b3 100644
--- a/components/provenance_gate/browser/provenance_gate_throttle.cc
+++ b/components/provenance_gate/browser/provenance_gate_throttle.cc
@@ -4,6 +4,7 @@
 #include <vector>
 
 #include "base/logging.h"
+#include "components/provenance_gate/browser/provenance_bypass_store.h"
 #include "components/provenance_gate/browser/provenance_evidence_store.h"
 #include "net/base/net_errors.h"
 #include "url/gurl.h"
@@ -26,6 +27,21 @@ void ProvenanceGateThrottle::WillProcessResponse(
   // bytes); navigations to an origin with recorded evidence are evaluated
   // against it. Mode A blocks on the recorded evidence (overridable); Mode
   // B still fails closed regardless.
+  // Series 0012: a bypass-marked navigation records the user's
+  // proceed-anywhere choice for the origin, then loads (block-on-detect
+  // mode only; provenance_required fails closed).
+  if (policy_.mode == Mode::kBlockOnDetect) {
+    const bool adopted =
+        ProvenanceBypassStore::Get().MaybeAdoptBypassRequest(response_url);
+    const bool bypassed =
+        adopted || ProvenanceBypassStore::Get().IsBypassed(response_url);
+    if (bypassed) {
+      VLOG(1) << "provenance_gate: url=" << response_url.spec()
+              << " allow=1 reason=user_bypass";
+      return;
+    }
+  }
+
   std::vector<Evidence> evidence =
       ProvenanceEvidenceStore::Get().GetEvidenceForOrigin(response_url);
   const auto decision = Evaluate(policy_, evidence);
